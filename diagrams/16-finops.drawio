"&gt;(AWS: Organizations + tag&lt;br&gt;policies)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Cost Management&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Cost Explorer)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Cost_Management.svg;" vertex="1" parent="1"><mxGeometry x="468" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Budgets + alerts&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: AWS Budgets)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Cost_Budgets.svg;" vertex="1" parent="1"><mxGeometry x="846" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Advisor&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Trusted Advisor /&lt;br&gt;Compute Optimizer)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Advisor.svg;" vertex="1" parent="1"><mxGeometry x="1224" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="243" width="1276" height="81" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="247" width="200" height="20" as="geometry"/></mxCell><mxCell id="c15" value