I clients&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="69" y="277" width="110" height="40" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Application Gateway +&lt;br&gt;WAF&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: ALB + WAF)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="352" y="277" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;API Management&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: API Gateway)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="646" y="277" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;App Service /&lt;br&gt;Functions&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda / Beanstalk)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/App_Services.svg;" vertex="1" parent="c2"><mxGeometry x="76" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;AKS&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EKS)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Kubernetes_Services.svg;" vertex="1" parent="c2"><mxGeometry x="76" y="253" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Self-hosted gateway&lt;br&gt;(container)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(no direct AWS equivalent)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="982" y="566" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;On-prem / other cloud&lt;br&gt;APIs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="566" width="160" height="48" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1340" height="97" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="954" width="200" height="20" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Quotas and keys on APIs&lt;/b&gt; → APIM&lt;br&gt;&lt;b&gt;APIs in several regions&lt;/b&gt; → APIM Premium&lt;br&gt;&lt;b&gt;APIs hosted on-prem or in other clouds&lt;/b&gt; → APIM self-hosted gateway&lt;br&gt;&lt;b&gt;API lifecycle vs web traffic + WAF&lt;/b&gt; → APIM vs Application Gateway: use both, App Gateway in front" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="976" width="1306" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>