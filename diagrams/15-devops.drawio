th="420" height="65" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Control / telemetry&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="583" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Observer&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1"><mxGeometry x="793" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Private path&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1045" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;PaaS target&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1255" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A = Architecture: how pieces connect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="62" y="434" width="250" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;D = Decision map: which service when&lt;br&gt;(table)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C55A11;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="434" width="280" height="48" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;C = Concept / cheat sheet&lt;/b&gt;" style="rounded=1;whit