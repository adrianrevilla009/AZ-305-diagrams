<mxfile host="app.diagrams.net" type="device"><diagram id="d0" name="0 Legend - Networking and connectivity"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1374" pageHeight="641" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c13" value="&lt;b&gt;0  Legend - Networking and connectivity&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="452" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Concept / cheat sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="502" y="19" width="160" height="22" as="geometry"/></mxCell><mxCell id="c15" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="675" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c16" value="How to read the diagrams in this file. Icons are draw.io&amp;#x27;s built-in Azure icon set; the orange text under each icon is the closest AWS equivalent." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1275" height="21" as="geometry"/></mxCell><mxCell id="c17" value="data flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="dashed = management / telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="orange = private / dedicated link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Azure service name&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: closest AWS&lt;br&gt;equivalent)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="121" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Another service&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;⚠ verify&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="331" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value="Bold text = Azure service. Orange text = closest AWS equivalent (taken&lt;br&gt;from your study document where it gives one). Amber &amp;#x27;⚠ verify&amp;#x27; = your&lt;br&gt;document flags the detail as to be verified (dates, SKUs, limits).&lt;br&gt;Amber &amp;#x27;+ added&amp;#x27; = a service I added that is not in your document." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="420" height="65" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Control / telemetry&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="583" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Observer&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1"><mxGeometry x="793" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Private path&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1045" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;PaaS target&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1255" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A = Architecture: how pieces connect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="62" y="434" width="250" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;D = Decision map: which service when&lt;br&gt;(table)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C55A11;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="434" width="280" height="48" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;C = Concept / cheat sheet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="434" width="230" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Dashed blue/green boxes = scope or boundary&lt;br&gt;(VNet, subnet, region, subscription...)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="898" y="434" width="300" height="48" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="517" width="1275" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="521" width="200" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Table colours&lt;/b&gt; → green = yes / supported, red = not supported, amber = caution, blue = key point&lt;br&gt;&lt;b&gt;Exam rules&lt;/b&gt; → each page ends with the &amp;#x27;Regla del examen&amp;#x27; pairs from the study document, translated to English" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="543" width="1241" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_1" name="4.1 Hub-and-spoke network"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1413" pageHeight="890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c16" value="&lt;b&gt;4.1  Hub-and-spoke network&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="302" height="30" as="geometry"/></mxCell><mxCell id="c17" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="352" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c18" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="466" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c19" value="A hub VNet holds shared services (gateways, firewall, DNS, Bastion). Each workload lives in its own spoke VNet peered to the hub. You run the routing yourself because peering is not transitive." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1314" height="21" as="geometry"/></mxCell><mxCell id="c2" value="Hub VNet - shared services  (AWS: hub VPC / Transit Gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="382" y="252" width="418" height="326" as="geometry"/></mxCell><mxCell id="c4" value="Spoke B VNet - workload  (AWS: VPC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#6FA800;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="991" y="419" width="363" height="159" as="geometry"/></mxCell><mxCell id="c3" value="Spoke A VNet - workload  (AWS: VPC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#6FA800;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="988" y="100" width="354" height="159" as="geometry"/></mxCell><mxCell id="c20" value="VPN / ER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="inspect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="peering + UDR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="peering + UDR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;On-premises network&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="112" y="292" width="140" height="40" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;VPN / ExpressRoute&lt;br&gt;gateway&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VGW / Transit&lt;br&gt;Gateway attachment)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="c2"><mxGeometry x="70" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Azure Firewall&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Network Firewall)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="c2"><mxGeometry x="280" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;DNS Private Resolver&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Route 53 Resolver&lt;br&gt;endpoints)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Private_Resolver.svg;" vertex="1" parent="c2"><mxGeometry x="70" y="207" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Azure Bastion&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SSM Session Manager)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Bastions.svg;" vertex="1" parent="c2"><mxGeometry x="280" y="207" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Workload VMs&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="c3"><mxGeometry x="41" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;UDR 0.0.0.0/0 to&lt;br&gt;firewall&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Route table)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Route_Tables.svg;" vertex="1" parent="c3"><mxGeometry x="251" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;AKS cluster&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EKS)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Kubernetes_Services.svg;" vertex="1" parent="c4"><mxGeometry x="38" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;NSG&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Security Group +&lt;br&gt;NACL)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="c4"><mxGeometry x="248" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c14" value="VNet peering is NOT transitive: spoke-to-spoke traffic must go through&lt;br&gt;the hub firewall / NVA with UDRs. Global peering connects VNets across&lt;br&gt;regions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="649" width="430" height="50" as="geometry"/></mxCell><mxCell id="c15" value="A VNet is regional. Subnets span the whole region (in AWS each subnet lives in&lt;br&gt;one AZ). Bastion gives browser RDP/SSH to VMs in peered spokes without public&lt;br&gt;IPs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="477" y="649" width="480" height="50" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="733" width="1314" height="97" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="737" width="200" height="20" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;One region, or you want full control&lt;/b&gt; → hub-spoke&lt;br&gt;&lt;b&gt;Many branches and regions, transitive routing&lt;/b&gt; → Virtual WAN&lt;br&gt;&lt;b&gt;TLS inspection / IDPS&lt;/b&gt; → Azure Firewall Premium&lt;br&gt;&lt;b&gt;Centralised Internet egress&lt;/b&gt; → UDR 0.0.0.0/0 to the firewall" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="759" width="1280" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_2" name="4.2 Virtual WAN"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1454" pageHeight="903" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c13" value="&lt;b&gt;4.2  Virtual WAN&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="260" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="310" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c15" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="424" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c16" value="Virtual WAN is a Microsoft-managed hub with automatic transitive routing between VNets, VPN and ExpressRoute. It scales to multi-hub global networks and is the answer for many branches or many regions." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1354" height="21" as="geometry"/></mxCell><mxCell id="c2" value="Region A - Virtual WAN hub  (Microsoft-managed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="470" y="242" width="334" height="371" as="geometry"/></mxCell><mxCell id="c3" value="Region B - Virtual WAN hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="848" y="242" width="197" height="159" as="geometry"/></mxCell><mxCell id="c17" value="VPN / SD-WAN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="ExpressRoute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="P2S" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="hub-to-hub (automatic)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="auto routing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="auto routing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Branch offices (SD-WAN /&lt;br&gt;VPN)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="125" y="100" width="170" height="48" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Datacenter on&lt;br&gt;ExpressRoute&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="125" y="313" width="170" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Remote users (P2S VPN)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="125" y="495" width="170" height="40" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Virtual hub - region A&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Transit Gateway)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_WAN_Hub.svg;" vertex="1" parent="c2"><mxGeometry x="74" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Secured hub: Azure&lt;br&gt;Firewall&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Network Firewall)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="c2"><mxGeometry x="74" y="253" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Virtual hub - region B&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Transit Gateway&lt;br&gt;(peered))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_WAN_Hub.svg;" vertex="1" parent="c3"><mxGeometry x="74" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Spoke VNets (region A)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC attachments)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="1299" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Spoke VNets (region B)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC attachments)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="1299" y="434" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value="Scale per hub: S2S VPN up to 20 Gbps, P2S 20 Gbps with 100,000 clients, VNet-to-VNet up to 50 Gbps. In&lt;br&gt;the hub you can only deploy Microsoft-managed resources." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="678" width="620" height="35" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="747" width="1354" height="97" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="751" width="200" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Many branches and regions, transitive routing&lt;/b&gt; → Virtual WAN&lt;br&gt;&lt;b&gt;SD-WAN branches&lt;/b&gt; → Virtual WAN&lt;br&gt;&lt;b&gt;Join on-prem sites over Microsoft&amp;#x27;s backbone&lt;/b&gt; → ExpressRoute Global Reach&lt;br&gt;&lt;b&gt;Only one region, full control&lt;/b&gt; → hub-spoke" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="773" width="1320" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_3" name="4.3 Hub-spoke vs Virtual WAN"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1070" pageHeight="538" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;4.3  Hub-spoke vs Virtual WAN&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="336" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="386" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="500" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Both build a hub network. Pick by size and by how much control you want over routing." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="970" height="21" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Traditional hub-spoke&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: hub VPC / Transit Gateway)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/networking/Virtual_Networks.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="210" y="100" width="400" height="86" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Virtual WAN&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Transit Gateway + Cloud WAN)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/networking/Virtual_WANs.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="400" height="86" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Who manages the hub&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="170" height="40" as="geometry"/></mxCell><mxCell id="c9" value="You deploy and operate gateways, firewall and DNS in the hub VNet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="186" width="400" height="40" as="geometry"/></mxCell><mxCell id="c10" value="Microsoft manages the hub; only Microsoft-managed resources can&lt;br&gt;be deployed in it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="186" width="400" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Routing between VNets&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="227" width="170" height="40" as="geometry"/></mxCell><mxCell id="c12" value="✗ Peering is not transitive: you build UDRs and run an&lt;br&gt;NVA/firewall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="227" width="400" height="40" as="geometry"/></mxCell><mxCell id="c13" value="✓ Automatic transitive routing between VNets, VPN and&lt;br&gt;ExpressRoute" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E0;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="227" width="400" height="40" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Scale&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="267" width="170" height="40" as="geometry"/></mxCell><mxCell id="c15" value="Limited by your gateway SKUs and your design" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="267" width="400" height="40" as="geometry"/></mxCell><mxCell id="c16" value="Multi-hub global. S2S VPN up to 20 Gbps, P2S 20 Gbps with 100,000&lt;br&gt;clients per hub, VNet-to-VNet up to 50 Gbps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="267" width="400" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Best fit&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="170" height="28" as="geometry"/></mxCell><mxCell id="c18" value="★ One region, or when you want full control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="308" width="400" height="28" as="geometry"/></mxCell><mxCell id="c19" value="★ Many branches (SD-WAN) or multi-region" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="308" width="400" height="28" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Exam keywords&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="170" height="28" as="geometry"/></mxCell><mxCell id="c21" value="&amp;#x27;one region&amp;#x27;, &amp;#x27;full control&amp;#x27;, &amp;#x27;custom NVA&amp;#x27;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="336" width="400" height="28" as="geometry"/></mxCell><mxCell id="c22" value="&amp;#x27;many branches&amp;#x27;, &amp;#x27;transitive&amp;#x27;, &amp;#x27;SD-WAN&amp;#x27;, &amp;#x27;multi-region&amp;#x27;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="336" width="400" height="28" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="970" height="81" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="402" width="200" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Many branches (SD-WAN) or multi-region&lt;/b&gt; → Virtual WAN&lt;br&gt;&lt;b&gt;One region, or you want total control&lt;/b&gt; → hub-spoke&lt;br&gt;&lt;b&gt;Peering is not transitive&lt;/b&gt; → you must build routes (UDR / NVA)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="424" width="936" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_4" name="4.4 Hybrid connectivity: VPN and ExpressRoute"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1278" pageHeight="983" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c10" value="&lt;b&gt;4.4  Hybrid connectivity: VPN and ExpressRoute&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="534" height="30" as="geometry"/></mxCell><mxCell id="c11" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="584" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c12" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="698" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c13" value="Site-to-site VPN rides the Internet (cheap, quick, also the backup). ExpressRoute is a private circuit with predictable latency and an SLA. Combine them for resilience." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1178" height="21" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Standard / ERGw1Az&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="674" width="250" height="34" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;High Performance / ERGw2Az&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="674" width="250" height="34" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Ultra Performance / ErGw3Az&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="674" width="250" height="34" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;ExpressRoute gateway SKU&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="170" height="28" as="geometry"/></mxCell><mxCell id="c18" value="4 connections, no FastPath" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="708" width="250" height="28" as="geometry"/></mxCell><mxCell id="c19" value="8 connections" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="708" width="250" height="28" as="geometry"/></mxCell><mxCell id="c20" value="16 connections, with FastPath" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="708" width="250" height="28" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Good to know&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="736" width="170" height="40" as="geometry"/></mxCell><mxCell id="c22" value="Gateway creation takes about 30-45 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="736" width="250" height="40" as="geometry"/></mxCell><mxCell id="c23" value="One circuit connects many VNets, which&lt;br&gt;share the bandwidth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="736" width="250" height="40" as="geometry"/></mxCell><mxCell id="c24" value="ExpressRoute Direct = 10/100 Gbps ports&lt;br&gt;+ MACsec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="736" width="250" height="40" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="IPsec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="private" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="Global Reach: sites talk over the Microsoft backbone" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;HQ datacenter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="130" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Branch datacenter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="328" width="130" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Remote users&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="541" width="130" height="40" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Site-to-Site VPN&lt;br&gt;(IPsec over Internet)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Site-to-Site VPN)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Local_Network_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="436" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;ExpressRoute circuit&lt;br&gt;(private, SLA)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Direct Connect)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/ExpressRoute_Circuits.svg;" vertex="1" parent="1"><mxGeometry x="436" y="328" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Point-to-Site&lt;br&gt;(OpenVPN, IKEv2, Entra&lt;br&gt;auth)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Client VPN)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/VPN_Client_Windows.svg;" vertex="1" parent="1"><mxGeometry x="436" y="541" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;VPN / ExpressRoute&lt;br&gt;gateway&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Virtual Private&lt;br&gt;Gateway)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="814" y="298" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Azure VNets (several&lt;br&gt;share one circuit)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="1129" y="298" width="48" height="48" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="811" width="1178" height="113" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="815" width="200" height="20" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Private, not over the Internet&lt;/b&gt; → ExpressRoute&lt;br&gt;&lt;b&gt;Quick to set up, or backup for ExpressRoute&lt;/b&gt; → VPN&lt;br&gt;&lt;b&gt;Join two on-prem sites over Microsoft&amp;#x27;s backbone&lt;/b&gt; → Global Reach&lt;br&gt;&lt;b&gt;Lower latency from on-prem to VMs&lt;/b&gt; → FastPath (Ultra Performance / ErGw3Az)&lt;br&gt;&lt;b&gt;L2 encryption on dedicated ports&lt;/b&gt; → ExpressRoute Direct + MACsec" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="837" width="1144" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_5" name="4.5 Private access to PaaS: Private Endpoint vs Service Endpoint"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1331" pageHeight="821" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c12" value="&lt;b&gt;4.5  Private access to PaaS: Private Endpoint vs Service Endpoint&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="754" height="30" as="geometry"/></mxCell><mxCell id="c13" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="804" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c14" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="918" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c15" value="A Private Endpoint gives a PaaS resource a private IP inside your VNet (works from on-prem too). A Service Endpoint only optimises the route; the service keeps its public IP." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1232" height="21" as="geometry"/></mxCell><mxCell id="c2" value="Your VNet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="415" y="100" width="521" height="401" as="geometry"/></mxCell><mxCell id="c16" value="private IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Private Link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Private Link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="resolves to private IP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="VPN/ER + DNS forwarding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;On-premises&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="108" y="368" width="130" height="40" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;VM / app in the VNet&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="c2"><mxGeometry x="70" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Private Endpoint&lt;br&gt;(private IP)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC interface&lt;br&gt;endpoint)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="c2"><mxGeometry x="406" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;DNS Private Resolver&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Route 53 Resolver&lt;br&gt;endpoints)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Private_Resolver.svg;" vertex="1" parent="c2"><mxGeometry x="70" y="268" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Private DNS zone&lt;br&gt;privatelink.*&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Route 53 private&lt;br&gt;hosted zone)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="c2"><mxGeometry x="406" y="268" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Storage Account&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1199" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;SQL Database&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1199" y="322" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value="Service Endpoint (AWS: gateway endpoint for S3/DynamoDB): traffic stays on the&lt;br&gt;Microsoft backbone but the service keeps its public IP. Only from VNets, not&lt;br&gt;from on-prem. No extra cost." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="581" width="470" height="50" as="geometry"/></mxCell><mxCell id="c11" value="App Service: VNet Integration = outbound; Private&lt;br&gt;Endpoint = inbound. They complement each other." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="677" y="581" width="330" height="35" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="1232" height="97" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="669" width="200" height="20" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;PaaS with no public endpoint&lt;/b&gt; → Private Endpoint&lt;br&gt;&lt;b&gt;Restrict Storage to a subnet at no cost&lt;/b&gt; → Service Endpoint&lt;br&gt;&lt;b&gt;Private Endpoint is failing&lt;/b&gt; → check DNS (privatelink.* zone linked to the VNet)&lt;br&gt;&lt;b&gt;Resolve Private Endpoints from on-prem&lt;/b&gt; → DNS Private Resolver" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="691" width="1198" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_6" name="4.6 Network security stack"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="735" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;4.6  Network security stack&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="313" height="30" as="geometry"/></mxCell><mxCell id="c12" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="363" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c13" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="477" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c14" value="Defence in depth on the network: DDoS and WAF at the edge, a central firewall for inspection, NSGs on every subnet, Bastion for admin access, NAT Gateway for fixed outbound IPs." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1500" height="21" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Basic&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="454" width="300" height="34" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Standard&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="454" width="300" height="34" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Premium&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="454" width="300" height="34" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Azure Firewall tiers (each&lt;br&gt;includes the previous)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="190" height="40" as="geometry"/></mxCell><mxCell id="c19" value="SMBs, about 250 Mbps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230" y="488" width="300" height="40" as="geometry"/></mxCell><mxCell id="c20" value="General use: network + application (FQDN) rules,&lt;br&gt;NAT, threat intelligence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="530" y="488" width="300" height="40" as="geometry"/></mxCell><mxCell id="c21" value="Adds TLS inspection, IDPS and URL / category&lt;br&gt;filtering" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="488" width="300" height="40" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="outbound" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="RDP/SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;Internet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="110" height="40" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;DDoS Protection&lt;br&gt;(L3/L4)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Shield Advanced)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DDoS_Protection_Plans.svg;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;WAF on App Gateway /&lt;br&gt;Front Door (L7)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: AWS WAF)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;" vertex="1" parent="1"><mxGeometry x="541" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Azure Firewall (L3-L7)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Network Firewall)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="1"><mxGeometry x="772" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;NSG per subnet / NIC&lt;br&gt;(L3-L4, stateful)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Security Group +&lt;br&gt;NACL)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="1003" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Workloads&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="1234" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;NAT Gateway (outbound)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: NAT Gateway)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/NAT.svg;" vertex="1" parent="1"><mxGeometry x="1465" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Firewall Manager&lt;br&gt;(central policy)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Firewall Manager)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Azure_Firewall_Manager.svg;" vertex="1" parent="1"><mxGeometry x="541" y="298" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Azure Bastion (admin&lt;br&gt;access)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SSM Session Manager)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Bastions.svg;" vertex="1" parent="1"><mxGeometry x="1003" y="298" width="48" height="48" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="1520" height="113" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="566" width="200" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;SQLi / XSS&lt;/b&gt; → WAF&lt;br&gt;&lt;b&gt;TLS inspection / IDPS&lt;/b&gt; → Azure Firewall Premium&lt;br&gt;&lt;b&gt;L3/L4 flood protection&lt;/b&gt; → DDoS Protection&lt;br&gt;&lt;b&gt;Admin RDP/SSH without a public IP&lt;/b&gt; → Azure Bastion&lt;br&gt;&lt;b&gt;Fixed outbound IP, no SNAT exhaustion&lt;/b&gt; → NAT Gateway" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="588" width="1486" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_7" name="4.7 Hybrid DNS and name resolution"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1315" pageHeight="824" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;4.7  Hybrid DNS and name resolution&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="406" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="456" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="570" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="Public names live in Azure DNS. Private names live in Private DNS zones linked to VNets. DNS Private Resolver forwards queries between on-prem and Azure so you don&amp;#x27;t run DNS VMs." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1216" height="21" as="geometry"/></mxCell><mxCell id="c13" value="conditional forwarding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="linked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="alias record (works at the apex)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;On-prem DNS servers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="282" width="150" height="40" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;DNS Private Resolver&lt;br&gt;(inbound + outbound&lt;br&gt;endpoints)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Route 53 Resolver&lt;br&gt;endpoints)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Private_Resolver.svg;" vertex="1" parent="1"><mxGeometry x="451" y="282" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Azure Private DNS&lt;br&gt;zones (virtual network&lt;br&gt;links)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Route 53 private&lt;br&gt;hosted zones)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="829" y="282" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;VNets / spokes&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="1186" y="282" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Azure DNS public zone&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Route 53 hosted&lt;br&gt;zones)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="451" y="541" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Front Door / Traffic&lt;br&gt;Manager / Public IP&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: CloudFront / Route&lt;br&gt;53 policies)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Front_Doors.svg;" vertex="1" parent="1"><mxGeometry x="829" y="541" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="Private Endpoint zones (privatelink.*) belong in Private DNS and must be linked to&lt;br&gt;every VNet that needs to resolve them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="35" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="684" width="1216" height="81" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="688" width="200" height="20" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Resolve Private Endpoints from on-prem&lt;/b&gt; → DNS Private Resolver&lt;br&gt;&lt;b&gt;Domain apex pointing to Front Door / Traffic Manager&lt;/b&gt; → Azure DNS alias record&lt;br&gt;&lt;b&gt;privatelink.* names&lt;/b&gt; → Private DNS zone linked to the VNet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="710" width="1182" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4_8" name="4.8 Azure Virtual Network Manager and Route Server (added)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1001" pageHeight="809" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c10" value="&lt;b&gt;4.8  Azure Virtual Network Manager and Route Server (added)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="684" height="30" as="geometry"/></mxCell><mxCell id="c11" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="734" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c12" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="848" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c13" value="Two services that are not in your study document but fit this topic. Virtual Network Manager applies connectivity and security rules to many VNets at&lt;br&gt;once; Route Server lets an NVA exchange routes with Azure over BGP." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="901" height="36" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="applies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="applies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="BGP peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="injects learned routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Virtual Network&lt;br&gt;Manager&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Network Manager /&lt;br&gt;Firewall Manager&lt;br&gt;(partial))&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;+ added&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Azure_Network_Manager.svg;" vertex="1" parent="1"><mxGeometry x="88" y="191" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Network group: Prod&lt;br&gt;VNets&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPCs)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="466" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Network group: Dev&lt;br&gt;VNets&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPCs)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="466" y="298" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Hub-spoke or mesh&lt;br&gt;connectivity&lt;br&gt;configuration&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Transit Gateway&lt;br&gt;attachments)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Subnet.svg;" vertex="1" parent="1"><mxGeometry x="844" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Security admin rules&lt;br&gt;(override NSGs)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Firewall Manager SG&lt;br&gt;policy)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Network_Security_Groups.svg;" vertex="1" parent="1"><mxGeometry x="844" y="298" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;NVA / SD-WAN appliance&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: third-party&lt;br&gt;appliance)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/VNet_Appliance.svg;" vertex="1" parent="1"><mxGeometry x="88" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Azure Route Server&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC Route Server)&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;+ added&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Router.svg;" vertex="1" parent="1"><mxGeometry x="466" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;VNet route table&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC route table)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="844" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="901" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="689" width="200" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Central connectivity and security admin rules for many VNets&lt;/b&gt; → Virtual Network Manager&lt;br&gt;&lt;b&gt;NVA / SD-WAN appliance needs dynamic routing&lt;/b&gt; → Route Server (BGP)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="711" width="867" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>