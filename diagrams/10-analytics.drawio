gn=top;image=img/lib/azure2/analytics/Data_Lake_Store_Gen1.svg;" vertex="1" parent="1"><mxGeometry x="366" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Purview: scan +&lt;br&gt;classify&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lake Formation /&lt;br&gt;Macie)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Purview_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="744" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Data map + catalog +&lt;br&gt;lineage&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Glue Data Catalog)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Purview_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1122" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="Governance domains, data products, access policies and sensitivity labels. Pairs with Defender for Cloud for security&lt;br&gt;posture." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="313" width="700" height="35" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="1177" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="386" width="200" height="20" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Catalog, lineage, classification&lt;/b&gt; → Purview&lt;br&gt;&lt;b&gt;Sensitivity labels&lt;/b&gt; → Purview Information Protection" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="408" width="1143" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d10_6" name="10.6 Fabric concepts"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1277" pageHeight="781" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c7" value="&lt;b&gt;10.6  Fabric concepts&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="260" height="30" as="geometry"/></mxCell><mxCell id="c8" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="310" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c9" value="AZ-305 domain: Data analytics (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="424" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c10" value="One capacity powers every Fabric workload on OneLake; shortcuts reference external data without copying, and Direct Lake reads lake files from Power BI." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1178" height="21" as="geometry"/></mxCell><mxCell id="c11" value="powers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="