3)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Data_Lake_Store_Gen1.svg;" vertex="1" parent="1"><mxGeometry x="447" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Synapse / Fabric&lt;br&gt;(batch)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Athena / Redshift)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Synapse_Analytics.svg;" vertex="1" parent="1"><mxGeometry x="825" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="533" width="900" height="81" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="537" width="200" height="20" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Real-time SQL on streams&lt;/b&gt; → Stream Analytics&lt;br&gt;&lt;b&gt;Replay / long retention&lt;/b&gt; → Capture to lake&lt;br&gt;&lt;b&gt;Telemetry store&lt;/b&gt; → Data Explorer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="559" width="866" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d10_5" name="10.5 Microsoft Purview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1276" pageHeight="506" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c6" value="&lt;b&gt;10.5  Microsoft Purview&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=