<mxfile host="app.diagrams.net" type="device"><diagram id="d0" name="0 Legend - Business continuity"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1374" pageHeight="641" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c13" value="&lt;b&gt;0  Legend - Business continuity&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="360" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Concept / cheat sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="410" y="19" width="160" height="22" as="geometry"/></mxCell><mxCell id="c15" value="AZ-305 domain: Business continuity (15-20%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="582" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c16" value="How to read the diagrams in this file. Icons are draw.io&amp;#x27;s built-in Azure icon set; the orange text under each icon is the closest AWS equivalent." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1275" height="21" as="geometry"/></mxCell><mxCell id="c17" value="data flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="dashed = management / telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="orange = private / dedicated link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Azure service name&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: closest AWS&lt;br&gt;equivalent)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="121" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Another service&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;⚠ verify&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="331" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value="Bold text = Azure service. Orange text = closest AWS equivalent (taken&lt;br&gt;from your study document where it gives one). Amber &amp;#x27;⚠ verify&amp;#x27; = your&lt;br&gt;document flags the detail as to be verified (dates, SKUs, limits).&lt;br&gt;Amber &amp;#x27;+ added&amp;#x27; = a service I added that is not in your document." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="420" height="65" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Control / telemetry&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="583" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Observer&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1"><mxGeometry x="793" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Private path&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1045" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;PaaS target&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1255" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A = Architecture: how pieces connect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="62" y="434" width="250" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;D = Decision map: which service when&lt;br&gt;(table)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C55A11;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="434" width="280" height="48" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;C = Concept / cheat sheet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="434" width="230" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Dashed blue/green boxes = scope or boundary&lt;br&gt;(VNet, subnet, region, subscription...)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="898" y="434" width="300" height="48" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="517" width="1275" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="521" width="200" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Table colours&lt;/b&gt; → green = yes / supported, red = not supported, amber = caution, blue = key point&lt;br&gt;&lt;b&gt;Exam rules&lt;/b&gt; → each page ends with the &amp;#x27;Regla del examen&amp;#x27; pairs from the study document, translated to English" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="543" width="1241" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d12_1" name="12.1 The four DR strategies"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="443" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;12.1  The four DR strategies&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="325" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="375" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Business continuity (15-20%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="489" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Cost falls and recovery time grows from active-active down to backup and restore. Pick by RTO/RPO versus budget." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="21" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Backup &amp;amp; restore&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Recovery_Services_Vaults.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="165" height="72" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Pilot light&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Recovery_Services_Vaults.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="315" y="100" width="165" height="72" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Warm standby&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Recovery_Services_Vaults.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="165" height="72" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Active-active&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Recovery_Services_Vaults.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="645" y="100" width="165" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;What runs in&lt;br&gt;region B&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="110" height="40" as="geometry"/></mxCell><mxCell id="c11" value="Only backups" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="172" width="165" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Data replicated, compute&lt;br&gt;off" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="172" width="165" height="40" as="geometry"/></mxCell><mxCell id="c13" value="Scaled-down full stack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="172" width="165" height="40" as="geometry"/></mxCell><mxCell id="c14" value="Full stack serving&lt;br&gt;traffic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="645" y="172" width="165" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;RTO / RPO&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="213" width="110" height="28" as="geometry"/></mxCell><mxCell id="c16" value="Hours / hours" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="213" width="165" height="28" as="geometry"/></mxCell><mxCell id="c17" value="Tens of minutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="213" width="165" height="28" as="geometry"/></mxCell><mxCell id="c18" value="Minutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="213" width="165" height="28" as="geometry"/></mxCell><mxCell id="c19" value="★ Near zero" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="645" y="213" width="165" height="28" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Cost&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="241" width="110" height="28" as="geometry"/></mxCell><mxCell id="c21" value="★ Lowest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="241" width="165" height="28" as="geometry"/></mxCell><mxCell id="c22" value="Low" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="241" width="165" height="28" as="geometry"/></mxCell><mxCell id="c23" value="Medium" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="241" width="165" height="28" as="geometry"/></mxCell><mxCell id="c24" value="Highest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="645" y="241" width="165" height="28" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="303" width="900" height="81" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="307" width="200" height="20" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Lowest RTO, highest cost&lt;/b&gt; → active-active&lt;br&gt;&lt;b&gt;Cheapest, slowest&lt;/b&gt; → backup and restore&lt;br&gt;&lt;b&gt;Core running, scale on failover&lt;/b&gt; → pilot light / warm standby" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="329" width="866" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d12_2" name="12.2 Azure Site Recovery"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1221" pageHeight="508" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c6" value="&lt;b&gt;12.2  Azure Site Recovery&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="290" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="340" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c8" value="AZ-305 domain: Business continuity (15-20%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="454" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c9" value="ASR replicates VMs continuously to a secondary region (or from on-prem) and orchestrates failover with recovery plans." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1121" height="21" as="geometry"/></mxCell><mxCell id="c10" value="continuous replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="failover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Primary region VMs&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="316" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Recovery Services&lt;br&gt;vault + ASR&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: AWS Elastic Disaster&lt;br&gt;Recovery)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Recovery_Services_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="694" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Secondary region VMs&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2 (DR))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="1072" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="Recovery plans sequence groups of VMs. Test failover runs in an isolated network." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="313" width="600" height="21" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="1121" height="81" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="372" width="200" height="20" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Replicate VMs to another region&lt;/b&gt; → Site Recovery&lt;br&gt;&lt;b&gt;Order failover steps&lt;/b&gt; → recovery plan&lt;br&gt;&lt;b&gt;Test without impact&lt;/b&gt; → test failover" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="394" width="1087" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d12_3" name="12.3 Azure Backup"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="353" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c5" value="&lt;b&gt;12.3  Azure Backup&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="260" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="310" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c7" value="AZ-305 domain: Business continuity (15-20%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="424" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c8" value="Backup vaults and Recovery Services vaults protect VMs, SQL, files and blobs with policies; immutability and soft delete guard against ransomware." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="21" as="geometry"/></mxCell><mxCell id="c9" value="scheduled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgro