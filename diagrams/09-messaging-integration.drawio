ow=block;endFill=1;strokeWidth=2;strokeColor=#C00000;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Producers&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda / apps)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="121" y="222" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Topic&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SNS topic)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="436" y="222" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Subscription A&lt;br&gt;(filter)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQS + filter policy)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="751" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Subscription B&lt;br&gt;(filter)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQS + filter policy)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="751" y="343" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Consumer 1&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1066" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Consumer 2&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1066" y="343" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Dead-letter queue&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQS DLQ)&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;after 10 deliveries&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="1066" y="222" width="48" height="48" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="686" width="1106" height="97" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="200" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Strict order, transactions, duplicates&lt;/b&gt; → Service Bus with sessions&lt;br&gt;&lt;b&gt;Messages up to 100 MB, VNet, geo-DR&lt;/b&gt; → Premium tier&lt;br&gt;&lt;b&gt;Process once, no loss&lt;/b&gt; → peek-lock (at-least-once, default)&lt;br&gt;&lt;b&gt;Messages replay&lt;/b&gt; → not possible in Service Bus (use Event Hubs)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="712" width="1072" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d9_3" name="9.3 Event Hubs: partitions, consumer groups, Capture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1368" pageHeight="1018" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;9.3  Event Hubs: partitions, consumer groups, Capture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="615" height="30" as="geometry"/></mxCell><mxCell id="c12" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="665" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c13" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="779" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c14" value="A partitioned log for millions of events per second. Order is guaranteed inside a partition; parallelism is capped by the partition count. Consumer groups read independently and can replay within the retention." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1268" height="21" as="geometry"/></mxCell><mxCell id="c2" value="Event Hubs namespace  (AWS: Kinesis stream / MSK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="406" y="100" width="346" height="514" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Standard&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="729" width="250" height="34" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Premium&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="729" width="250" height="34" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Dedicated&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="729" width="250" height="34" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Capacity&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="763" width="90" height="40" as="geometry"/></mxCell><mxCell id="c19" value="Throughput Units: each 1 MB/s in, 2 MB/s&lt;br&gt;out. Retention up to 7 days" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="763" width="250" height="40" as="geometry"/></mxCell><mxCell id="c20" value="Processing Units, isolation, retention&lt;br&gt;up to 90 days" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="763" width="250" height="40" as="geometry"/></mxCell><mxCell id="c21" value="Clusters with Capacity Units" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="630" y="763" width="250" height="40" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Extras&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="804" width="90" height="40" as="geometry"/></mxCell><mxCell id="c23" value="Auto-Inflate raises TUs automatically" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="804" width="250" height="40" as="geometry"/></mxCell><mxCell id="c24" value="Schema Registry, geo-replication for DR,&lt;br&gt;SLA up to 99.99%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="804" width="250" height="40" as="geometry"/></mxCell><mxCell id="c25" value="Kafka endpoint + AMQP 1.0 + HTTPS (all&lt;br&gt;tiers); no dead-letter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="630" y="804" width="250" height="40" as="geometry"/></mxCell><mxCell id="c26" value="partition key = order per key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Capture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value='&lt;b&gt;Producers (apps,&lt;br&gt;devices)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Kinesis producers)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/iot/IoT_Hub.svg;" vertex="1" parent="1"><mxGeometry x="121" y="292" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Partition 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="40" width="140" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Partition 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="177" width="140" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Partition 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="314" width="140" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Partition 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="450" width="140" height="40" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Stream Analytics&lt;br&gt;(consumer group 1)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Managed Flink)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Stream_Analytics_Jobs.svg;" vertex="1" parent="1"><mxGeometry x="877" y="186" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Functions (consumer&lt;br&gt;group 2)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="877" y="398" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Capture to Blob / ADLS&lt;br&gt;(Avro)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Firehose to S3)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1213" y="292" width="48" height="48" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="878" width="1268" height="81" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="882" width="200" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Millions of events/s with replay&lt;/b&gt; → Event Hubs&lt;br&gt;&lt;b&gt;Migrate Kafka without code changes&lt;/b&gt; → Event Hubs Kafka endpoint&lt;br&gt;&lt;b&gt;Archive the stream automatically&lt;/b&gt; → Capture to Blob / ADLS (Avro)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="904" width="1234" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d9_4" name="9.4 Event-driven and telemetry pipelines"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1299" pageHeight="872" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c12" value="&lt;b&gt;9.4  Event-driven and telemetry pipelines&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="476" height="30" as="geometry"/></mxCell><mxCell id="c13" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="526" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c14" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="640" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c15" value="Two classic patterns. Discrete events: a blob creation triggers a function that queues work. Continuous telemetry: Event Hubs feeds Stream Analytics that writes to a database or the lake." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1199" height="21" as="geometry"/></mxCell><mxCell id="c16" value="event" style="edgeStyle=orthogonalEdgeStyle;rounded=