eat sheet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="434" width="230" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Dashed blue/green boxes = scope or boundary&lt;br&gt;(VNet, subnet, region, subscription...)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="898" y="434" width="300" height="48" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="517" width="1275" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="521" width="200" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Table colours&lt;/b&gt; → green = yes / supported, red = not supported, amber = caution, blue = key point&lt;br&gt;&lt;b&gt;Exam rules&lt;/b&gt; → each page ends with the &amp;#x27;Regla del examen&amp;#x27; pairs from the study document, translated to English" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="543" width="1241" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d9_1" name="9.1 Message vs event: which service?"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="655" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;9.1  Message vs event: which service?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="429" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="479" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="593" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="A message is something the sender expects someone to process (an order, a payment): Service Bus or Storage Queue. An event is a notification that something&lt;br&gt;happened: Event Grid for discrete events, Event Hubs for continuous streams of telemetry." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="940" height="36" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Service Bus&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQS FIFO + SNS / Amazon&lt;br&gt;MQ)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/integration/Service_Bus.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="180" y="100" width="200" height="101" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Event Grid&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EventBridge / SNS)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/integration/Event_Grid_Topics.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="380" y="100" w