keColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="580" y="350" width="200" height="28" as="geometry"/></mxCell><mxCell id="c34" value="✗ No" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="350" width="200" height="28" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Size / notes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="140" height="55" as="geometry"/></mxCell><mxCell id="c36" value="Premium messages up to 100 MB&lt;br&gt;(256 KB below)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="180" y="378" width="200" height="55" as="geometry"/></mxCell><mxCell id="c37" value="Destinations: Functions, Logic&lt;br&gt;Apps, Service Bus, Event Hubs,&lt;br&gt;Queue, webhooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="378" width="200" height="55" as="geometry"/></mxCell><mxCell id="c38" value="Capture to Blob/ADLS in Avro.&lt;br&gt;Kafka, AMQP 1.0, HTTPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="580" y="378" width="200" height="55" as="geometry"/></mxCell><mxCell id="c39" value="Queues over 80 GB, no DLQ, no&lt;br&gt;sessions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="378" width="200" height="55" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="940" height="129" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="200" height="20" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Strict order, transactions, duplicate detection&lt;/b&gt; → Service Bus with sessions&lt;br&gt;&lt;b&gt;Millions of events/s with replay&lt;/b&gt; → Event Hubs&lt;br&gt;&lt;b&gt;React to an Azure event&lt;/b&gt; → Event Grid&lt;br&gt;&lt;b&gt;Migrate Kafka without code changes&lt;/b&gt; → Event Hubs (Kafka endpoint)&lt;br&gt;&lt;b&gt;Telemetry without commands&lt;/b&gt; → Event Hubs&lt;br&gt;&lt;b&gt;Simple cheap queue (&amp;gt;80 GB)&lt;/b&gt; → Storage Queue" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="492" width="906" height="97" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d9_2" name="9.2 Service Bus: queues, topics and tiers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1206" pageHeight="842" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;9.2  Service Bus: queues, topics and tiers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="487" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="537" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="651" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="Enterprise broker. Topics fan out to subscriptions with filters (like SNS filter policies to SQS). Sessions give FIFO per key; failed messages move to the dead-letter queue after the max&lt;br&gt;delivery count (10 by default)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1106" height="36" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Basic&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="537" width="240" height="34" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Standard&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="537" width="240" height="34" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Premium&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="537" width="360" height="34" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Tier&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="571" width="90" height="40" as="geometry"/></mxCell><mxCell id="c17" value="Queues only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="571" width="240" height="40" as="geometry"/></mxCell><mxCell id="c18" value="Topics and transactions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="571" width="240" height="40" as="geometry"/></mxCell><mxCell id="c19" value="Dedicated resources, messages up to 100 MB (vs 256 KB),&lt;br&gt;VNet / Private Link, geo-DR, zones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="571" width="360" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Notes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="90" height="40" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="612" width="240" height="40" as="geometry"/></mxCell><mxCell id="c22" value="Sessions = FIFO per session key, one&lt;br&gt;consumer per session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="612" width="240" height="40" as="geometry"/></mxCell><mxCell id="c23" value="Geo-DR replicates only metadata, not the messages ⚠ see&lt;br&gt;12.5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="612" w