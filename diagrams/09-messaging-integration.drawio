ntryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="hot path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="cold path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Blob created&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3 event)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Blob_Block.svg;" vertex="1" parent="1"><mxGeometry x="62" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Event Grid (system&lt;br&gt;topic)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EventBridge)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Event_Grid_Topics.svg;" vertex="1" parent="1"><mxGeometry x="334" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Function&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="608" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Service Bus queue&lt;br&gt;(with DLQ)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQS + DLQ)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="881" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Worker / Logic App&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Step Functions)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Logic_Apps.svg;" vertex="1" parent="1"><mxGeometry x="1154" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Devices / apps&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: IoT Core)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/iot/IoT_Hub.svg;" vertex="1" parent="1"><mxGeometry x="62" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Event Hubs&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Kinesis)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Event_Hubs.svg;" vertex="1" parent="1"><mxGeometry x="334" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Stream Analytics (SQL)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Managed Flink)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Stream_Analytics_Jobs.svg;" vertex="1" parent="1"><mxGeometry x="608" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Cosmos DB (hot)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: DynamoDB)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;" vertex="1" parent="1"><mxGeometry x="881" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;ADLS Gen2 (cold path)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3 + Lake Formation)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Data_Lake_Store_Gen1.svg;" vertex="1" parent="1"><mxGeometry x="880" y="602" width="48" height="48" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="1199" height="97" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="720" width="200" height="20" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;React to an Azure event&lt;/b&gt; → Event Grid&lt;br&gt;&lt;b&gt;SQL on streams in real time&lt;/b&gt; → Stream Analytics&lt;br&gt;&lt;b&gt;Work queue with DLQ&lt;/b&gt; → Service Bus&lt;br&gt;&lt;b&gt;Telemetry without commands&lt;/b&gt; → Event Hubs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="742" width="1165" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d9_5" name="9.5 IoT: IoT Hub, DPS, IoT Central"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1225" pageHeight="841" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;9.5  IoT: IoT Hub, DPS, IoT Central&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="406" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="456" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="570" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="IoT Hub is bidirectional (device-to-cloud and cloud-to-device) with an identity and a device twin per device. Its endpoint is Event Hubs-compatible. DPS provisions devices without touching&lt;br&gt;them; IoT Central is the ready-made SaaS." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1126" height="36" as="geometry"/></mxCell><mxCell id="c13" value="zero-touch provisioning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Event Hubs-compatible endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="SaaS on top" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Devices (IoT Edge)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Greengrass&lt;br&gt;(approx.))&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;+ added&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/iot/IoT_Edge.svg;" vertex="1" parent="1"><mxGeometry x="74" y="252" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Device Provisioning&lt;br&gt;Service&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: IoT fleet&lt;br&gt;provisioning)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/iot/Device_Provisioning_Services.svg;" vertex="1" parent="1"><mxGeometry x="390" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;IoT Hub (D2C + C2D,&lt;br&gt;twin)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: IoT Core)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/iot/IoT_Hub.svg;" vertex="1" parent="1"><mxGeometry x="390" y="328" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Stream Analytics&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Managed Flink)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Stream_Analytics_Jobs.svg;" vertex="1" parent="1"><mxGeometry x="746" y="328" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Cosmos DB / Data&lt;br&gt;Explorer / ADLS&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: DynamoDB /&lt;br&gt;Timestream)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;" vertex="1" parent="1"><mxGeometry x="1082" y="328" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;IoT Central (SaaS)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: IoT SiteWise&lt;br&gt;(partial))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/iot/IoT_Central_Applications.svg;" vertex="1" parent="1"><mxGeometry x="746" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Digital Twins&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: IoT TwinMaker)&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;+ added&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/iot/Digital_Twins.svg;" vertex="1" parent="1"><mxGeometry x="1082" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="1126" height="97" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="689" width="200" height="20" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Devices that receive commands&lt;/b&gt; → IoT Hub&lt;br&gt;&lt;b&gt;Telemetry without commands&lt;/b&gt; → Event Hubs&lt;br&gt;&lt;b&gt;Zero-touch device onboarding&lt;/b&gt; → Device Provisioning Service&lt;br&gt;&lt;b&gt;Ready-made IoT SaaS&lt;/b&gt; → IoT Central" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="711" width="1092" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d9_6" name="9.6 Real-time web, push and low-code"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="869" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;9.6  Real-time web, push and low-code&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="429" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="479" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="