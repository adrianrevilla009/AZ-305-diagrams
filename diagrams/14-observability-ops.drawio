l=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="Platform metrics + Activity Log (automatic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="40" width="300" height="44" as="geometry"/></mxCell><mxCell id="c4" value="Resource logs (need diagnostic settings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="119" width="300" height="44" as="geometry"/></mxCell><mxCell id="c5" value="Guest OS logs (AMA + DCR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="198" width="300" height="44" as="geometry"/></mxCell><mxCell id="c6" value="Application (Application Insights)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="277" width="300" height="44" as="geometry"/></mxCell><mxCell id="c7" value="Entra ID sign-in + audit (tenant diagnostic&lt;br&gt;settings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="356" width="300" height="44" as="geometry"/></mxCell><mxCell id="c8" value="AKS (Container Insights + Managed Prometheus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="435" width="300" height="44" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Diagnostic settings&lt;br&gt;(up to 5 per resource)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Diagnostics_Settings.svg;" vertex="1" parent="1"><mxGeometry x="696" y="231" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Azure Monitor Agent +&lt;br&gt;DCR (filter /&lt;br&gt;transform with KQL)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: CloudWatch Agent)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Data_Collection_Rules.svg;" vertex="1" parent="1"><mxGeometry x="696" y="429" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Log Analytics (KQL,&lt;br&gt;alerts, Sentinel)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: CloudWatch Logs +&lt;br&gt;Logs Insights)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="1116" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Storage Account (cheap&lt;br&gt;archive, audit)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1116" y="307" width="48" height="48" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Event Hubs (stream to&lt;br&gt;Splunk / QRadar)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Kinesis)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Event_Hubs.svg;" vertex="1" parent="1"><mxGeometry x="1116" y="474" width="48" height="48" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Partner solution&lt;br&gt;(Datadog, Elastic)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Marketplace.svg;" vertex="1" parent="1"><mxGeometry x="1116" y="642" width="48" height="48" as="geometry"/></mxCell><mxCell id="c15" value="AMA replaces the old MMA / Log Analytics agent (retired ⚠ verify dates). The retention policy inside a diagnostic setting is deprecated:&lt;br&gt;use Storage lifecycle management." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="809" width="820" height="35" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="878" width="1172" height="113" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="882" width="200" height="20" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Monitor, alert and dashboard&lt;/b&gt; → Azure Monitor&lt;br&gt;&lt;b&gt;KQL over logs from several resources&lt;/b&gt; → Log Analytics&lt;br&gt;&lt;b&gt;Resource logs to Splunk&lt;/b&gt; → diagnostic setting to Event Hubs&lt;br&gt;&lt;b&gt;Archive logs cheaply&lt;/b&gt; → Storage or total retention&lt;br&gt;&lt;b&gt;Guest OS logs&lt;/b&gt; → AMA + DCR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="904" width="1138" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d14_2" name="14.2 Alerts and action groups"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1416" pageHeight="858" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c12" value="&lt;b&gt;14.2  Alerts and action groups&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="348" height="30" as="geometry"/></mxCell><mxCell id="c13" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="398" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c14" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="512" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c15" value="Pick the alert type by speed and logic, then route it to an action group. One action group can be reused by many rules." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1316" height="21" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="Metric alert: near-real-time, cheap, dynamic&lt;br&gt;thresholds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="48" as="geometry"/></mxCell><mxCell id="c3" value="Log search alert: KQL query, flexible but slower&lt;br&gt;and costlier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="300" height="48" as="geometry"/></mxCell><mxCell id="c4" value="Activity log alert: delete a VM, RBAC changes,&lt;br&gt;Service Health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="300" height="48" as="geometry"/></mxCell><mxCell id="c5" value="Prometheus alert (AKS) / Smart detection (App&lt;br&gt;Insights, ML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="300" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Action group&lt;br&gt;(reusable)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SNS + EventBridge)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Alerts.svg;" vertex="1" parent="1"><mxGeometry x="544" y="328" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Function&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="901" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Logic App&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Step Functions)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Logic_Apps.svg;" vertex="1" parent="1"><mxGeometry x="901" y="267" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Automation runbook&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SSM Automation)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Automation_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="901" y="434" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Event Hubs / ITSM&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Event_Hubs.svg;" vertex="1" parent="1"><mxGeometry x="901" y="602" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Email, SMS, push, voice,&lt;br&gt;webhook&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1166" y="267" width="190" height="48" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="1316" height="97" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="706" width="200" height="20" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Fast alert&lt;/b&gt; → metric alert&lt;br&gt;&lt;b&gt;Complex logic&lt;/b&gt; → log search alert&lt;br&gt;&lt;b&gt;VM deleted or RBAC change&lt;/b&gt; → activity log alert&lt;br&gt;&lt;b&gt;Autoscale VMSS / App Service on a metric&lt;/b&gt; → Autoscale (AWS: Auto Scaling policies)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="728" width="1282" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d14_3" name="14.3 Log Analytics workspace design"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="889" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;14.3  Log Analytics workspace design&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="418" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="468" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="582" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="One central workspace by default (simplest and cheapest). Split by region for data sovereignty, by team or environment for admin or billing separation, and keep a&lt;br&gt;dedicated one for Sentinel." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="980" height="36" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Analytics&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="100" width="270" height="34" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Basic&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="270" height="34" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Auxiliary&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="100" width="270" height="34" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Use for&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="170" height="28" as="geometry"/></mxCell><mxCell id="c10" value="Critical logs, alerts and full queries" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="134" width="270" height="28" as="geometry"/></mxCell><mxCell id="c11" value="High-volume, rarely queried logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="134" width="270" height="28" as="geometry"/></mxCell><mxCell id="c12" value="Low-value, audit and cheap long retention" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="134" width="270" height="28" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Interactive retention&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="170" height="40" as="geometry"/></mxCell><mxCell id="c14" value="30 days (90 days for Sentinel and App&lt;br&gt;Insights), up to 2 years" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="162" width="270" height="40" as="geometry"/></mxCell><mxCell id="c15" value="Fixed 30 days of query" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="162" width="270" height="40" as="geometry"/></mxCell><mxCell id="c16" value="Minimal ingestion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="162" width="270" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Alerts&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="203" width="170" height="28" as="geometry"/></mxCell><mxCell id="c18" value="✓ Yes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E0;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="203" width="270" height="28" as="geometry"/></mxCell><mxCell id="c19" value="⚠ Limited ⚠ verify" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="203" width="270" height="28" as="geometry"/></mxCell><mxCell id="c20" value="✗ No" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="203" width="270" height="28" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Total retention (with&lt;br&gt;archive)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="231" width="170" height="40" as="geometry"/></mxCell><mxCell id="c22" value="Up to 12 years in all three plans" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="231" width="270" height="40" as="geometry"/></mxCell><mxCell id="c23" value="Up to 12 years" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="231" width="270" height="40" as="geometry"/></mxCell><mxCell id="c24" value="Up to 12 years" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="231" width="270" height="40" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Placement and access&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="556" width="810" height="34" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Workspace layout&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="170" height="40" as="geometry"/></mxCell><mxCell id="c27" value="Central by default; per region/country for sovereignty; per team/env for admin or billing separation; dedicated workspace for Sentinel&lt;br&gt;(different retention and cost)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="590" width="810" height="40" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Access&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="631" width="170" height="28" as="geometry"/></mxCell><mxCell id="c29" value="Resource-context RBAC: each team sees only the logs of its resources. Or table-level RBAC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="631" width="810" height="28" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Operations&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="659" width="170" height="28" as="geometry"/></mxCell><mxCell id="c31" value="Search jobs and restore recover archived data on demand. Data export rules export tables continuously to Storage or Event Hubs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="659" width="810" height="28" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Cost&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="687" width="170" height="28" as="geometry"/></mxCell><mxCell id="c33" value="Commitment tiers give a discount from 100 GB/day. ⚠ Daily cap stops ingestion when reached, and data is lost, including security data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="687" width="810" height="28" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="749" width="980" height="81" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="753" width="200" height="20" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;KQL over logs of several resources&lt;/b&gt; → Log Analytics&lt;br&gt;&lt;b&gt;Archive logs cheaply&lt;/b&gt; → Storage, or total retention (up to 12 years)&lt;br&gt;&lt;b&gt;Each team sees only its resources&amp;#x27; logs&lt;/b&gt; → resource-context RBAC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="775" width="946" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d14_4" name="14.4 Application, container and VM insights"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1394" pageHeight="819" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c8" value="&lt;b&gt;14.4  Application, container and VM insights&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="510" height="30" as="geometry"/></mxCell><mxCell id="c9" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="560" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c10" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="674" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c11" value="Application Insights is APM (traces, dependencies, exceptions) and is workspace-based: its data lives in Log Analytics. Container Insights and VM Insights cover AKS and VMs through Azure Monitor Agent." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1295" height="21" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;Apps (SDK or&lt;br&gt;auto-instrumentation,&lt;br&gt;OpenTelemetry)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="93" y="125" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Application Insights&lt;br&gt;(workspace-based)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: X-Ray + CloudWatch&lt;br&gt;Application Signals)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Application_Insights.svg;" vertex="1" parent="1"><mxGeometry x="450" y="125" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;AKS: Container&lt;br&gt;Insights + Managed&lt;br&gt;Prometheus / Grafana&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Container Insights /&lt;br&gt;Managed Prometheus)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Kubernetes_Services.svg;" vertex="1" parent="1"><mxGeometry x="93" y="384" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;VM Insights (AMA)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: CloudWatch Agent +&lt;br&gt;Application Insights)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="450" y="566" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Log Analytics&lt;br&gt;workspace&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: CloudWatch Logs)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="870" y="338" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="Features: Application Map (dependencies), Live Metrics, distributed&lt;br&gt;tracing, availability tests (public URL from several regions), Smart&lt;br&gt;Detection, Profiler, Snapshot Debugger, sampling to reduce cost.&lt;br&gt;Classic mode is retired." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="915" y="100" width="420" height="65" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="1295" height="64" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="699" width="200" height="20" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;App performance, dependencies, exceptions&lt;/b&gt; → Application Insights&lt;br&gt;&lt;b&gt;Logs of the OS&lt;/b&gt; → AMA + DCR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="721" width="1261" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d14_5" name="14.5 Diagnostics: who did what, what's broken, where is it"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1030" pageHeight="569" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;14.5  Diagnostics: who did what, what&amp;#x27;s broken, where is it&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="684" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="734" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="848" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Four tools answer four different questions." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="930" height="21" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Network Watcher&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC Flow Logs +&lt;br&gt;Reachability Analyzer + Traffic&lt;br&gt;Mirroring)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/networking/Network_Watcher.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="130" y="100" width="210" height="115" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Activity Log&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: CloudTrail)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/management_governance/Activity_Log.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="210" height="115" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Service Health / Resource&lt;br&gt;Health&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: AWS Health Dashboard)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/general/Service_Health.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="210" height="115" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Resource Graph&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Config aggregator /&lt;br&gt;Resource Explorer)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/management_governance/Resource_Graph_Explorer.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="210" height="115" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Answers&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="90" height="55" as="geometry"/></mxCell><mxCell id="c11" value="Why is my VM not receiving&lt;br&gt;traffic? Is endpoint A reaching&lt;br&gt;B?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="215" width="210" height="55" as="geometry"/></mxCell><mxCell id="c12" value="Who created or deleted a resource&lt;br&gt;(control plane)?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340" y="215" width="210" height="55" as="geometry"/></mxCell><mxCell id="c13" value="Is Azure having an incident that&lt;br&gt;affects me?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="550" y="215" width="210" height="55" as="geometry"/></mxCell><mxCell id="c14" value="What exists across all my&lt;br&gt;subscriptions?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="215" width="210" height="55" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Features&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="269" width="90" height="69" as="geometry"/></mxCell><mxCell id="c16" value="Connection Monitor, NSG / VNet&lt;br&gt;flow logs + Traffic Analytics, IP&lt;br&gt;flow verify, next hop, packet&lt;br&gt;capture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="130" y="269" width="210" height="69" as="geometry"/></mxCell><mxCell id="c17" value="Automatic, 90 days retention; use&lt;br&gt;a diagnostic setting for longer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340" y="269" width="210" height="69" as="geometry"/></mxCell><mxCell id="c18" value="Service Health: incidents and&lt;br&gt;maintenance on your subscription.&lt;br&gt;Resource Health: one resource.&lt;br&gt;Azure Status: global" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="550" y="269" width="210" height="69" as="geometry"/></mxCell><mxCell id="c19" value="KQL at scale over resource&lt;br&gt;inventory. Change Analysis shows&lt;br&gt;who changed what" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="269" width="210" height="69" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Note&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="90" height="40" as="geometry"/></mxC