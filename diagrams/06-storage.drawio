om=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="170" height="86" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Premium SSD&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Disks.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="490" y="100" width="170" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Premium SSD v2&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Disks.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="170" height="86" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Ultra Disk&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: io2 Block Express)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Disks.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="170" height="86" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Performance&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="110" height="55" as="geometry"/></mxCell><mxCell id="c12" value="About 500 IOPS, 60 MB/s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="186" width="170" height="55" 