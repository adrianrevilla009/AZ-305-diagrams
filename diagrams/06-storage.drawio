st" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="241" width="170" height="40" as="geometry"/></mxCell><mxCell id="c20" value="Production and SQL. ZRS&lt;br&gt;version available" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="490" y="241" width="170" height="40" as="geometry"/></mxCell><mxCell id="c21" value="High performance without&lt;br&gt;Ultra cost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="241" width="170" height="40" as="geometry"/></mxCell><mxCell id="c22" value="Most demanding databases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="241" width="170" height="40" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Limits&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="110" height="28" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="281" width="170" height="28" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="281" width="170" height="28" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="490" y="281" width="170" height="28" as="geometry"/></mxCell><mxCell id="c27" value="✗ Cannot be an OS disk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="281" width="170" height="28" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="281" width="170" height="28" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="960" height="81" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="347" width="200" height="20" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;High IOPS and sub-ms latency&lt;/b&gt; → Ultra Disk&lt;br&gt;&lt;b&gt;Cluster shared disk (WSFC, SQL FCI)&lt;/b&gt; → shared disks&lt;br&gt;&lt;b&gt;HA across zones&lt;/b&gt; → ZRS disks" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="369" width="926" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d6_6" name="6.6 Data Lake Storage Gen2 and the other storage services"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="766" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;6.6  Data Lake Storage Gen2 and the other storage services&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="673" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="723" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="837" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="ADLS Gen2 is a storage account with the hierarchical namespace turned on, giving POSIX ACLs for Spark, Synapse, Fabric and Databricks. The same account type also&lt;br&gt;hosts Blob, Files, Queue and Table." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="951" height="36" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Ingest (Data Factory)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Glue ETL)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Data_Factory.svg;" vertex="1" parent="1"><mxGeometry x="206" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;ADLS Gen2:&lt;br&gt;hierarchical namespace&lt;br&gt;+ POSIX ACLs&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3 + Lake Formation)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Data_Lake_Store_Gen1.svg;" vertex="1" parent="1"><mxGeometry x="542" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Synapse / Fabric /&lt;br&gt;Databricks&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EMR / Athena /&lt;br&gt;Redshift)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="899" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Queue Storage&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQS (basic))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Storage_Queue.svg;" vertex="1" parent="1"><mxGeometry x="542" y="358" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Table Storage&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: DynamoDB (basic))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Table.svg;" vertex="1" parent="1"><mxGeometry x="899" y="358" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Azure Files&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EFS / FSx for&lt;br&gt;Windows)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Storage_Azure_Files.svg;" vertex="1" parent="1"><mxGeometry x="206" y="358" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="Lake security: POSIX ACLs + RBAC, Private Endpoint, CMK. Managed VNet in Data Factory and Synapse with&lt;br&gt;data-exfiltration protection." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="700" height="35" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="951" height="81" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="629" width="200" height="20" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Data lake with POSIX ACLs&lt;/b&gt; → ADLS Gen2&lt;br&gt;&lt;b&gt;Simple cheap queue&lt;/b&gt; → Storage Queue (SQS basic)&lt;br&gt;&lt;b&gt;Simple NoSQL key-value&lt;/b&gt; → Table Storage (DynamoDB basic)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="651" width="917" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>