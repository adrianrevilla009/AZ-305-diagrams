<mxfile host="app.diagrams.net" type="device"><diagram id="d0" name="0 Legend - Compute"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1374" pageHeight="641" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c13" value="&lt;b&gt;0  Legend - Compute&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="260" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Concept / cheat sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="310" y="19" width="160" height="22" as="geometry"/></mxCell><mxCell id="c15" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="482" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c16" value="How to read the diagrams in this file. Icons are draw.io&amp;#x27;s built-in Azure icon set; the orange text under each icon is the closest AWS equivalent." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1275" height="21" as="geometry"/></mxCell><mxCell id="c17" value="data flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="dashed = management / telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="orange = private / dedicated link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Azure service name&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: closest AWS&lt;br&gt;equivalent)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="121" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Another service&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;⚠ verify&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="331" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value="Bold text = Azure service. Orange text = closest AWS equivalent (taken&lt;br&gt;from your study document where it gives one). Amber &amp;#x27;⚠ verify&amp;#x27; = your&lt;br&gt;document flags the detail as to be verified (dates, SKUs, limits).&lt;br&gt;Amber &amp;#x27;+ added&amp;#x27; = a service I added that is not in your document." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="420" height="65" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Control / telemetry&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="583" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Observer&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1"><mxGeometry x="793" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Private path&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1045" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;PaaS target&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1255" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A = Architecture: how pieces connect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="62" y="434" width="250" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;D = Decision map: which service when&lt;br&gt;(table)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C55A11;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="434" width="280" height="48" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;C = Concept / cheat sheet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="434" width="230" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Dashed blue/green boxes = scope or boundary&lt;br&gt;(VNet, subnet, region, subscription...)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="898" y="434" width="300" height="48" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="517" width="1275" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="521" width="200" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Table colours&lt;/b&gt; → green = yes / supported, red = not supported, amber = caution, blue = key point&lt;br&gt;&lt;b&gt;Exam rules&lt;/b&gt; → each page ends with the &amp;#x27;Regla del examen&amp;#x27; pairs from the study document, translated to English" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="543" width="1241" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_1" name="7.1 Compute decision map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="583" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;7.1  Compute decision map&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="290" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="340" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="454" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Pick by how much you want to manage: full OS control (VM), managed web apps (App Service), serverless containers (Container Apps), full Kubernetes (AKS), one-off container (ACI), event code&lt;br&gt;(Functions), batch jobs (Batch)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1160" height="36" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Virtual Machines&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Virtual_Machine.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="150" height="101" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;App Service&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Elastic Beanstalk&lt;br&gt;/ App Runner)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/App_Services.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="150" height="101" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Container Apps&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: App Runner / ECS&lt;br&gt;Fargate)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/other/Container_App_Environments.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="150" height="101" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;AKS&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EKS)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Kubernetes_Services.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="150" height="101" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Container Instances&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Fargate (single&lt;br&gt;task))&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Container_Instances.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="750" y="100" width="150" height="101" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Functions&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Function_Apps.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="150" height="101" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Batch&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: AWS Batch)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Batch_Accounts.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="1050" y="100" width="150" height="101" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Pick it when&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="201" width="110" height="69" as="geometry"/></mxCell><mxCell id="c14" value="Full OS control, COTS&lt;br&gt;software,&lt;br&gt;lift-and-shift" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="201" width="150" height="69" as="geometry"/></mxCell><mxCell id="c15" value="Web apps and APIs&lt;br&gt;without managing&lt;br&gt;servers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="201" width="150" height="69" as="geometry"/></mxCell><mxCell id="c16" value="Containers without&lt;br&gt;managing Kubernetes;&lt;br&gt;events or HTTP; scale&lt;br&gt;to zero" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="201" width="150" height="69" as="geometry"/></mxCell><mxCell id="c17" value="You need Kubernetes&lt;br&gt;control: operators,&lt;br&gt;CRDs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="201" width="150" height="69" as="geometry"/></mxCell><mxCell id="c18" value="One container or a&lt;br&gt;group, no orchestration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="201" width="150" height="69" as="geometry"/></mxCell><mxCell id="c19" value="Event-driven code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="201" width="150" height="69" as="geometry"/></mxCell><mxCell id="c20" value="Parallel and HPC jobs&lt;br&gt;on pools of VMs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1050" y="201" width="150" height="69" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;You manage&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="269" width="110" height="55" as="geometry"/></mxCell><mxCell id="c22" value="The OS and everything&lt;br&gt;above" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="269" width="150" height="55" as="geometry"/></mxCell><mxCell id="c23" value="Just the app (plan&lt;br&gt;sizing)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="269" width="150" height="55" as="geometry"/></mxCell><mxCell id="c24" value="Containers and scaling&lt;br&gt;rules (KEDA); not K8s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="269" width="150" height="55" as="geometry"/></mxCell><mxCell id="c25" value="Nodes pools, upgrades,&lt;br&gt;K8s objects" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="269" width="150" height="55" as="geometry"/></mxCell><mxCell id="c26" value="Nothing but the&lt;br&gt;container; manual scale" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="269" width="150" height="55" as="geometry"/></mxCell><mxCell id="c27" value="Just the code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="269" width="150" height="55" as="geometry"/></mxCell><mxCell id="c28" value="Pools and jobs; the&lt;br&gt;service itself has no&lt;br&gt;extra cost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1050" y="269" width="150" height="55" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Scale / limits&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="110" height="69" as="geometry"/></mxCell><mxCell id="c30" value="VM Scale Sets (Flexible&lt;br&gt;mode recommended)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="324" width="150" height="69" as="geometry"/></mxCell><mxCell id="c31" value="Up to 30 instances, 100&lt;br&gt;with ASE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="324" width="150" height="69" as="geometry"/></mxCell><mxCell id="c32" value="KEDA, revisions and&lt;br&gt;traffic splitting, Dapr" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="324" width="150" height="69" as="geometry"/></mxCell><mxCell id="c33" value="HPA, cluster&lt;br&gt;autoscaler, KEDA;&lt;br&gt;virtual nodes (ACI) for&lt;br&gt;bursts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="324" width="150" height="69" as="geometry"/></mxCell><mxCell id="c34" value="Billed per second,&lt;br&gt;manual scale" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="324" width="150" height="69" as="geometry"/></mxCell><mxCell id="c35" value="About 200 instances per&lt;br&gt;function app" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="324" width="150" height="69" as="geometry"/></mxCell><mxCell id="c36" value="Batch + Spot VMs for&lt;br&gt;cheap bulk work" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1050" y="324" width="150" height="69" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="427" width="1160" height="97" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="431" width="200" height="20" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Full OS control, COTS, lift-and-shift&lt;/b&gt; → VM&lt;br&gt;&lt;b&gt;Managed web app / API&lt;/b&gt; → App Service&lt;br&gt;&lt;b&gt;Containers, no K8s to manage, scale to zero&lt;/b&gt; → Container Apps&lt;br&gt;&lt;b&gt;Operators, CRDs, full K8s control&lt;/b&gt; → AKS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="453" width="558" height="65" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;A one-off container&lt;/b&gt; → ACI&lt;br&gt;&lt;b&gt;Zero-downtime release and instant rollback&lt;/b&gt; → App Service deployment slots&lt;br&gt;&lt;b&gt;Thousands of cheap batch tasks&lt;/b&gt; → Batch + Spot" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="618" y="453" width="558" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_2" name="7.2 Highly available VMs"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="981" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c13" value="&lt;b&gt;7.2  Highly available VMs&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="290" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="340" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c15" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="454" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c16" value="VM SLA depends on placement: single instance with Premium SSD/Ultra 99.9%, Availability Set 99.95%, Availability Zones 99.99%. Scale Sets spread instances across zones behind a&lt;br&gt;zone-redundant Load Balancer." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1040" height="36" as="geometry"/></mxCell><mxCell id="c5" value="VM Scale Set - Flexible mode (autoscale)  (AWS: Auto Scaling Group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="464" height="550" as="geometry"/></mxCell><mxCell id="c2" value="Zone 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#8A8A8A;arcSize=3;container=0;" vertex="1" parent="c5"><mxGeometry x="26" y="40" width="212" height="136" as="geometry"/></mxCell><mxCell id="c3" value="Zone 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#8A8A8A;arcSize=3;container=0;" vertex="1" parent="c5"><mxGeometry x="26" y="215" width="212" height="136" as="geometry"/></mxCell><mxCell id="c4" value="Zone 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#8A8A8A;arcSize=3;container=0;" vertex="1" parent="c5"><mxGeometry x="26" y="390" width="212" height="136" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Single instance (Premium SSD / Ultra)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="712" width="300" height="34" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Availability Set (2+ VMs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="712" width="300" height="34" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Availability Zones (2+ VMs in different zones)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="712" width="330" height="34" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;VM SLA&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="746" width="110" height="28" as="geometry"/></mxCell><mxCell id="c21" value="99.9%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="746" width="300" height="28" as="geometry"/></mxCell><mxCell id="c22" value="99.95% (fault + update domains)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="746" width="300" height="28" as="geometry"/></mxCell><mxCell id="c23" value="99.99%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="746" width="330" height="28" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value='&lt;b&gt;Load Balancer Standard&lt;br&gt;(zone-redundant)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: NLB)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Load_Balancers.svg;" vertex="1" parent="1"><mxGeometry x="121" y="343" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;VM instance&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="c2"><mxGeometry x="82" y="36" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;VM instance&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="c3"><mxGeometry x="82" y="36" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;VM instance&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="c4"><mxGeometry x="82" y="36" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Proximity placement&lt;br&gt;group&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Cluster placement&lt;br&gt;group)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Proximity_Placement_Groups.svg;" vertex="1" parent="1"><mxGeometry x="898" y="176" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Dedicated Host&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2 Dedicated Hosts)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Hosts.svg;" vertex="1" parent="1"><mxGeometry x="898" y="351" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Spot VMs / Hybrid&lt;br&gt;Benefit&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Spot Instances /&lt;br&gt;BYOL)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Spot_VM.svg;" vertex="1" parent="1"><mxGeometry x="898" y="526" width="48" height="48" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="808" width="1040" height="113" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="812" width="200" height="20" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Survive a datacenter failure&lt;/b&gt; → Availability Zones (99.99%)&lt;br&gt;&lt;b&gt;Same datacenter, rack-level protection&lt;/b&gt; → Availability Set (99.95%)&lt;br&gt;&lt;b&gt;VMs close together, low latency&lt;/b&gt; → Proximity placement group&lt;br&gt;&lt;b&gt;Licensing / compliance hardware&lt;/b&gt; → Dedicated Host&lt;br&gt;&lt;b&gt;Interruptible, up to 90% cheaper&lt;/b&gt; → Spot VMs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="834" width="1006" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_3" name="7.3 App Service: plans, slots and networking"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1528" pageHeight="959" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c10" value="&lt;b&gt;7.3  App Service: plans, slots and networking&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="522" height="30" as="geometry"/></mxCell><mxCell id="c11" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="572" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c12" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="686" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c13" value="An App Service Plan is the compute; several apps can share it. Deployment slots give blue/green releases with a swap. VNet Integration is outbound, Private Endpoint is inbound." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1428" height="21" as="geometry"/></mxCell><mxCell id="c2" value="App Service Plan = the compute (shared by apps). Standard+ for autoscale and slots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="704" y="100" width="561" height="173" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Free / Shared&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Basic&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="425" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Standard&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="575" y="524" width="190" height="34" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Premium v3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765" y="524" width="150" height="34" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Isolated v2 / ASE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="915" y="524" width="230" height="34" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Tier&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="195" y="558" width="80" height="40" as="geometry"/></mxCell><mxCell id="c20" value="Dev / small" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="275" y="558" width="150" height="40" as="geometry"/></mxCell><mxCell id="c21" value="No autoscale or slots" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="425" y="558" width="150" height="40" as="geometry"/></mxCell><mxCell id="c22" value="★ Autoscale + deployment&lt;br&gt;slots" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="575" y="558" width="190" height="40" as="geometry"/></mxCell><mxCell id="c23" value="More power, zone&lt;br&gt;redundancy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" v