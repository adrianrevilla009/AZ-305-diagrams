d=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="570" y="325" width="210" height="40" as="geometry"/></mxCell><mxCell id="c36" value="The plan you already pay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="325" width="210" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;Durable Functions&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Step Functions)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Function_Apps.svg;" vertex="1" parent="1"><mxGeometry x="163" y="803" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value="Durable Functions: stateful orchestrations written in code (retries, fan-out/fan-in).&lt;br&gt;About 200 instances max per function app." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="325" y="813" width="520" height="35" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="917" width="950" height="81" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="921" width="200" height="20" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Function that reaches the VNet&lt;/b&gt; → Flex Consumption or Premium&lt;br&gt;&lt;b&gt;No cold start&lt;/b&gt; → Premium&lt;br&gt;&lt;b&gt;Stateful orchestration in code&lt;/b&gt; → Durable Functions (AWS Step Functions)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="943" width="916" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_5" name="7.5 AKS reference architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1819" pageHeight="914" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c16" value="&lt;b&gt;7.5  AKS reference architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="360" height="30" as="geometry"/></mxCell><mxCell id="c17" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="410" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c18" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="524" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c19" value="Node pools spread across zones, secrets via Workload Identity and Key Vault, images from ACR over Private Link, telemetry to Log Analytics. Scale with HPA, cluster autoscaler and KEDA; use virtual nodes (ACI) for bursts." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1500" height="21" as="geometry"/></mxCell><mxCell id="c2" value="AKS cluster  (AWS: EKS)  - Azure CNI or kubenet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFA;strokeColor=#7B4FB2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#7B4FB2;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="654" y="100" width="482" height="493" as="geometry"/></mxCell><mxCell id="c3" value="Observe and protect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#8A8A8A;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="1554" y="176" width="205" height="355" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="ingress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="no secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B9A00;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Users&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="184" y="307" width="90" height="40" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;App Gateway (AGIC /&lt;br&gt;for Containers)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: ALB + LB Controller)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Application_Gateway_Containers.svg;" vertex="1" parent="1"><mxGeometry x="415" y="307" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;System node pool&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="40" width="190" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;User node pools spread over&lt;br&gt;zones 1-3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="207" width="190" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Spot node pool&lt;br&gt;(interruptible)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="374" width="190" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Virtual nodes (ACI)&lt;br&gt;for bursts&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Fargate burst)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Container_Instances.svg;" vertex="1" parent="c2"><mxGeometry x="370" y="374" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Container Registry&lt;br&gt;(Premium:&lt;br&gt;geo-replication,&lt;br&gt;Private Link)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: ECR)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="1360" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Key Vault (CSI driver)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Secrets Manager)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="1360" y="307" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Workload Identity&lt;br&gt;(Entra)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: IRSA)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Entra_Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="1360" y="474" width="48" height="48" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Container Insights +&lt;br&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: CloudWatch Container&lt;br&gt;Insights)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="c3"><mxGeometry x="79" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Defender for&lt;br&gt;Containers&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: GuardDuty EKS + ECR&lt;br&gt;scanning)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Azure_Defender.svg;" vertex="1" parent="c3"><mxGeometry x="79" y="222" width="48" height="48" as="geometry"/></mxCell><mxCell id="c15" value="Control plane is free in the Free tier; the Standard tier adds an SLA. Azure Policy for Kubernetes and Entra authentication harden the cluster.&lt;br&gt;Autoscaling: HPA, cluster autoscaler, KEDA." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="672" width="900" height="35" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="741" width="1720" height="113" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="745" width="200" height="20" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Pods access Azure without secrets&lt;/b&gt; → Workload Identity&lt;br&gt;&lt;b&gt;K8s control, operators, CRDs&lt;/b&gt; → AKS&lt;br&gt;&lt;b&gt;Without managing Kubernetes&lt;/b&gt; → Container Apps&lt;br&gt;&lt;b&gt;HA for node pools&lt;/b&gt; → spread across availability zones&lt;br&gt;&lt;b&gt;L7 ingress for AKS&lt;/b&gt; → AGIC / Application Gateway for Containers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="767" width="1686" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_6" name="7.6 Container Apps: serverless containers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1504" pageHeight="676" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;7.6  Container Apps: serverless containers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="487" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="537" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="651" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="Container Apps runs containers without exposing Kubernetes. KEDA scales on HTTP or events (down to zero), revisions allow canary traffic splitting, Dapr gives service-to-service building blocks." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1404" height="21" as="geometry"/></mxCell><mxCell id="c2" value="Container Apps environment  (AWS: App Runner / ECS Fargate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFA;strokeColor=#7B4FB2;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#7B4FB2;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="308" y="100" width="821" height="402" as="geometry"/></mxCell><mxCell id="c13" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value='&lt;b&gt;Event sources: HTTP,&lt;br&gt;Service Bus, Event&lt;br&gt;Hubs&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQS / Kinesis)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="81" y="262" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;KEDA scaler (0 to N)&lt;/b&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;scales to zero&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="c2"><mxGeometry x="67" y="162" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Revision 1 (80%&lt;br&gt;traffic)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Fargate service)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="c2"><mxGeometry x="382" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Revision 2 (20%&lt;br&gt;canary)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Fargate service)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Worker_Container_App.svg;" vertex="1" parent="c2"><mxGeometry x="382" y="283" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Dapr sidecar&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: App Mesh (approx.))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Container_Instances.svg;" vertex="1" parent="c2"><mxGeometry x="697" y="162" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: ECR)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="1362" y="262" width="48" height="48" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="1404" height="81" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="200" height="20" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Containers, scale to zero, no K8s&lt;/b&gt; → Container Apps&lt;br&gt;&lt;b&gt;Percentage of traffic to a new version&lt;/b&gt; → revisions + traffic splitting&lt;br&gt;&lt;b&gt;Event-driven scaling&lt;/b&gt; → KEDA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="562" width="1370" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_7" name="7.7 Batch, HPC and specialised compute"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1145" pageHeight="626" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;7.7  Batch, HPC and specialised compute&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="452" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="502" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="616" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="Azure Batch runs parallel work on pools of VMs (Spot to save money). The service itself has no extra cost. CycleCloud covers classic HPC clusters; Service Fabric and ARO are&lt;br&gt;niche." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1046" height="36" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Input data (Blob)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="71" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Batch account: jobs +&lt;br&gt;tasks&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: AWS Batch)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Batch_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="386" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Pool: dedicated + Spot&lt;br&gt;VMs&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Spot Fleet)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/VM_Scale_Sets.svg;" vertex="1" parent="1"><mxGeometry x="701" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Results (Blob)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1016" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;CycleCloud (classic&lt;br&gt;HPC clusters)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: ParallelCluster&lt;br&gt;(approx.))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Azure_HPC_Workbench.svg;" vertex="1" parent="1"><mxGeometry x="386" y="343" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Service Fabric&lt;br&gt;(stateful&lt;br&gt;microservices; de&lt;br&gt;facto retiring)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Service_Fabric_Clusters.svg;" vertex="1" parent="1"><mxGeometry x="701" y="343" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Azure Red Hat&lt;br&gt;OpenShift&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: ROSA)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/containers/Azure_Red_Hat_OpenShift.svg;" vertex="1" parent="1"><mxGeometry x="1016" y="343" width="48" height="48" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="1046" height="81" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="200" height="20" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Thousands of cheap batch tasks&lt;/b&gt; → Batch + Spot&lt;br&gt;&lt;b&gt;Classic HPC clusters (Slurm, PBS)&lt;/b&gt; → CycleCloud&lt;br&gt;&lt;b&gt;Managed OpenShift&lt;/b&gt; → Azure Red Hat OpenShift (AWS ROSA)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="512" width="1012" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_8" name="7.8 Azure Virtual Desktop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1398" pageHeight="381" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c7" value="&lt;b&gt;7.8  Azure Virtual Desktop&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="302" height="30" as="geometry"/></mxCell><mxCell id="c8" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="352" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c9" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="466" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c10" value="Multi-session Windows desktops on host pools. User profiles roam with FSLogix on Azure Files or NetApp Files; Entra ID and Conditional Access control sign-in; autoscale starts and stops hosts." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1299" height="21" as="geometry"/></mxCell><mxCell id="c11" value="sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="profile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;Remote users&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="110" height="40" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Entra ID + Conditional&lt;br&gt;Access&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: IAM Identity Center)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Conditional_Access.svg;" vertex="1" parent="1"><mxGeometry x="323" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;AVD control plane&lt;br&gt;(host pools, app&lt;br&gt;groups)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: WorkSpaces /&lt;br&gt;AppStream)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Windows_Virtual_Desktop.svg;" vertex="1" parent="1"><mxGeometry x="617" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Session hosts&lt;br&gt;(multi-session,&lt;br&gt;autoscale)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: WorkSpaces pool)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Host_Pools.svg;" vertex="1" parent="1"><mxGeometry x="932" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;FSLogix profiles on&lt;br&gt;Azure Files / NetApp&lt;br&gt;Files&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: FSx for Windows /&lt;br&gt;EFS)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Storage_Azure_Files.svg;" vertex="1" parent="1"><mxGeometry x="1247" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="257" width="1299" height="64" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="261" width="200" height="20" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Windows multi-session desktops&lt;/b&gt; → Azure Virtual Desktop&lt;br&gt;&lt;b&gt;User profiles for pooled hosts&lt;/b&gt; → FSLogix on Azure Files / NetApp Files" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="283" width="1265" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>