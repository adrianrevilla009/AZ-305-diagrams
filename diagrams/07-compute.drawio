tive="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;Clients&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="208" y="140" width="100" height="40" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Private Endpoint&lt;br&gt;(inbound)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC interface&lt;br&gt;endpoint)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="465" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Web app - production&lt;br&gt;slot&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Elastic Beanstalk /&lt;br&gt;App Runner)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/App_Services.svg;" vertex="1" parent="c2"><mxGeometry x="76" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Staging slot (warm-up,&lt;br&gt;tests)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Blue/green&lt;br&gt;environment)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Web_Slots.svg;" vertex="1" parent="c2"><mxGeometry x="370" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;VNet (private&lt;br&gt;resources)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VPC)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="1074" y="368" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;SQL / Storage via&lt;br&gt;Private Endpoint&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS / S3)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1389" y="368" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="Slot settings marked &amp;#x27;sticky&amp;#x27; do not move with a swap. A swap with preview warms the target slot before it takes traffic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="800" height="21" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="803" width="1428" height="97" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="807" width="200" height="20" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Zero-downtime release, quick rollback&lt;/b&gt; → deployment slots (Standard tier or higher)&lt;br&gt;&lt;b&gt;Full isolation in your VNet&lt;/b&gt; → Isolated v2 / ASE&lt;br&gt;&lt;b&gt;PaaS reaching a private DB&lt;/b&gt; → VNet Integration (outbound)&lt;br&gt;&lt;b&gt;Block public access to the app&lt;/b&gt; → Private Endpoint (inbound)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="829" width="1394" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7_4" name="7.4 Functions hosting plans"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1057" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c4" value="&lt;b&gt;7.4  Functions hosting plans&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="325" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="375" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c6" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="489" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c7" value="Same programming model, four hosting plans. Flex Consumption is the recommended serverless choice for new work; Premium removes cold starts; Dedicated reuses a&lt;br&gt;plan you already pay for." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="950" height="36" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Consumption (classic)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Function_Apps.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="210" height="101" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Flex Consumption (recommended)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Lambda)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/comput