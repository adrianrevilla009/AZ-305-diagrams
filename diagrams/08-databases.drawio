<mxfile host="app.diagrams.net" type="device"><diagram id="d0" name="0 Legend - Databases"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1374" pageHeight="641" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c13" value="&lt;b&gt;0  Legend - Databases&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="260" height="30" as="geometry"/></mxCell><mxCell id="c14" value="Concept / cheat sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="310" y="19" width="160" height="22" as="geometry"/></mxCell><mxCell id="c15" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="482" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c16" value="How to read the diagrams in this file. Icons are draw.io&amp;#x27;s built-in Azure icon set; the orange text under each icon is the closest AWS equivalent." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1275" height="21" as="geometry"/></mxCell><mxCell id="c17" value="data flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="dashed = management / telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="orange = private / dedicated link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#C55A11;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Azure service name&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: closest AWS&lt;br&gt;equivalent)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="121" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Another service&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: S3)&lt;/font&gt;&lt;br&gt;&lt;font color="#B8860B"&gt;⚠ verify&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="331" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value="Bold text = Azure service. Orange text = closest AWS equivalent (taken&lt;br&gt;from your study document where it gives one). Amber &amp;#x27;⚠ verify&amp;#x27; = your&lt;br&gt;document flags the detail as to be verified (dates, SKUs, limits).&lt;br&gt;Amber &amp;#x27;+ added&amp;#x27; = a service I added that is not in your document." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="420" height="65" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Control / telemetry&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="583" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Observer&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1"><mxGeometry x="793" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Private path&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1045" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;PaaS target&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1255" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A = Architecture: how pieces connect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="62" y="434" width="250" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;D = Decision map: which service when&lt;br&gt;(table)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C55A11;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="434" width="280" height="48" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;C = Concept / cheat sheet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="434" width="230" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Dashed blue/green boxes = scope or boundary&lt;br&gt;(VNet, subnet, region, subscription...)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="898" y="434" width="300" height="48" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="517" width="1275" height="64" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="521" width="200" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Table colours&lt;/b&gt; → green = yes / supported, red = not supported, amber = caution, blue = key point&lt;br&gt;&lt;b&gt;Exam rules&lt;/b&gt; → each page ends with the &amp;#x27;Regla del examen&amp;#x27; pairs from the study document, translated to English" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="543" width="1241" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8_1" name="8.1 Azure SQL options: which one?"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="482" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;8.1  Azure SQL options: which one?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="394" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="444" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="558" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Choose by compatibility versus management effort: SQL Database (PaaS, single or pool), Managed Instance (near-100% SQL Server compatibility), SQL Server&lt;br&gt;on a VM (full OS control)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="36" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;SQL Database&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS for SQL Server)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/SQL_Database.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="190" height="86" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;SQL Managed Instance&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS for SQL Server)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/SQL_Managed_Instance.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="190" height="86" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;SQL Server on VM&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2 + SQL Server)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/compute/Virtual_Machine.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="190" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Model&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="110" height="40" as="geometry"/></mxCell><mxCell id="c10" value="PaaS, single DB or elastic&lt;br&gt;pool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="186" width="190" height="40" as="geometry"/></mxCell><mxCell id="c11" value="PaaS, instance scoped, in&lt;br&gt;your VNet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340" y="186" width="190" height="40" as="geometry"/></mxCell><mxCell id="c12" value="IaaS, you manage the OS and&lt;br&gt;engine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="530" y="186" width="190" height="40" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Compatibility&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="227" width="110" height="40" as="geometry"/></mxCell><mxCell id="c14" value="Most features, no&lt;br&gt;instance-level ones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="227" width="190" height="40" as="geometry"/></mxCell><mxCell id="c15" value="★ Near 100%: SQL Agent,&lt;br&gt;cross-DB queries, CLR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340" y="227" width="190" height="40" as="geometry"/></mxCell><mxCell id="c16" value="★ 100%, any version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="530" y="227" width="190" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Pick it when&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="267" width="110" height="40" as="geometry"/></mxCell><mxCell id="c18" value="New cloud apps, SaaS&lt;br&gt;multi-tenant (pool)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="267" width="190" height="40" as="geometry"/></mxCell><mxCell id="c19" value="★ Lift and shift of SQL&lt;br&gt;Server with minimal change" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340" y="267" width="190" height="40" as="geometry"/></mxCell><mxCell id="c20" value="Unsupported features, OS&lt;br&gt;access, or licence control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="530" y="267" width="190" height="40" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="900" height="81" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="346" width="200" height="20" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Near-100% SQL Server compatibility, lift and shift&lt;/b&gt; → SQL Managed Instance&lt;br&gt;&lt;b&gt;Full control, unsupported features&lt;/b&gt; → SQL Server on VM&lt;br&gt;&lt;b&gt;Many databases with variable load&lt;/b&gt; → Elastic pool" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="368" width="866" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8_2" name="8.2 SQL Database purchase and service tiers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1005" pageHeight="693" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;8.2  SQL Database purchase and service tiers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="510" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="560" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c5" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="674" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c6" value="Two purchasing models (vCore and DTU) and three main tiers; Hyperscale scales storage up to 100 TB, Serverless pauses when idle." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="905" height="21" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;General Purpose&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/SQL_Database.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="265" y="100" width="170" height="101" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Business Critical&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/SQL_Database.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="435" y="100" width="170" height="101" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Hyperscale&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Aurora (similar&lt;br&gt;idea))&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/SQL_Database.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="605" y="100" width="170" height="101" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Serverless&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/SQL_Database.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="775" y="100" width="170" height="101" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Architecture&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="155" y="201" width="110" height="55" as="geometry"/></mxCell><mxCell id="c12" value="Remote storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="265" y="201" width="170" height="55" as="geometry"/></mxCell><mxCell id="c13" value="Local SSD, Always On&lt;br&gt;replicas (readable)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="435" y="201" width="170" height="55" as="geometry"/></mxCell><mxCell id="c14" value="Distributed page servers,&lt;br&gt;up to 100 TB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="605" y="201" width="170" height="55" as="geometry"/></mxCell><mxCell id="c15" value="General Purpose compute&lt;br&gt;that auto-scales and&lt;br&gt;auto-pauses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="775" y="201" width="170" height="55" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Pick it when&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="155" y="255" width="110" height="40" as="geometry"/></mxCell><mxCell id="c17" value="Most workloads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="265" y="255" width="170" height="40" as="geometry"/></mxCell><mxCell id="c18" value="★ Lowest latency and&lt;br&gt;highest IOPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="435" y="255" width="170" height="40" as="geometry"/></mxCell><mxCell id="c19" value="★ Very large or&lt;br&gt;fast-growing DBs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="605" y="255" width="170" height="40" as="geometry"/></mxCell><mxCell id="c20" value="★ Intermittent use, pay&lt;br&gt;per second" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="775" y="255" width="170" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Purchasing: vCore (flexible, reserved capacity, Hybrid Benefit) or DTU (bundled). Hybrid Benefit reuses existing SQL&lt;br&gt;licences." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="700" height="35" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="553" width="905" height="81" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="557" width="200" height="20" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Unpredictable, idle periods&lt;/b&gt; → Serverless&lt;br&gt;&lt;b&gt;Very large DB, fast scale&lt;/b&gt; → Hyperscale&lt;br&gt;&lt;b&gt;Low-latency, in-memory&lt;/b&gt; → Business Critical" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="579" width="871" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8_3" name="8.3 SQL HA and DR"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1413" pageHeight="578" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;8.3  SQL HA and DR&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="260" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="310" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="424" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="Zone redundancy gives HA within a region; active geo-replication or failover groups give DR across regions with a readable secondary." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1314" height="21" as="geometry"/></mxCell><mxCell id="c3" value="Region B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#6FA800;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="1166" y="100" width="188" height="173" as="geometry"/></mxCell><mxCell id="c2" value="Region A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#0078D4;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="164" height="159" as="geometry"/></mxCell><mxCell id="c13" value="connect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="primary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="async replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Application&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="186" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Failover group&lt;br&gt;listener endpoint&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Aurora global&lt;br&gt;endpoint)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="501" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Primary region&lt;br&gt;(zone-redundant)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS Multi-AZ)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="c2"><mxGeometry x="58" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Secondary region&lt;br&gt;(readable)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Cross-region read&lt;br&gt;replica)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="c3"><mxGeometry x="70" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="Backups: automatic PITR (up to 35 days) and long-term retention (up to&lt;br&gt;10 years) ⚠ verify." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="420" height="35" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="437" width="1314" height="81" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="441" width="200" height="20" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Automatic regional failover with one endpoint&lt;/b&gt; → failover group&lt;br&gt;&lt;b&gt;Zone outage&lt;/b&gt; → zone-redundant&lt;br&gt;&lt;b&gt;Restore after error&lt;/b&gt; → PITR / LTR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="463" width="1280" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8_4" name="8.4 Cosmos DB: global distribution"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1230" pageHeight="507" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c6" value="&lt;b&gt;8.4  Cosmos DB: global distribution&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="406" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="456" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c8" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="570" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c9" value="Multi-region writes give active-active with low latency worldwide; conflict resolution defaults to last-writer-wins. Choose the API by the existing data model." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1130" height="21" as="geometry"/></mxCell><mxCell id="c10" value="replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Region 1 (read/write)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: DynamoDB global&lt;br&gt;tables)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;" vertex="1" parent="1"><mxGeometry x="406" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Region 2 (read/write)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;" vertex="1" parent="1"><mxGeometry x="742" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Region 3 (read/write)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;" vertex="1" parent="1"><mxGeometry x="1078" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="APIs: NoSQL, MongoDB, Cassandra, Gremlin, Table, PostgreSQL. Throughput: provisioned, autoscale or serverless. Partition key choice&lt;br&gt;decides scale and cost." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="780" height="35" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="367" width="1130" height="81" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="371" width="200" height="20" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Global low latency writes&lt;/b&gt; → multi-region writes&lt;br&gt;&lt;b&gt;Existing MongoDB&lt;/b&gt; → API for MongoDB&lt;br&gt;&lt;b&gt;Graph&lt;/b&gt; → Gremlin API" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="393" width="1096" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8_5" name="8.5 Cosmos DB consistency ladder"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="468" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;8.5  Cosmos DB consistency ladder&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="383" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="433" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="547" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Five levels trade consistency for latency and availability. Session is the default and fits most apps." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="21" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Strong&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="150" height="72" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Bounded staleness&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="150" height="72" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Session&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="150" height="72" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Consistent prefix&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="150" height="72" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Eventual&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="750" y="100" width="150" height="72" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Guarantee&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="110" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Linearizable reads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="172" width="150" height="40" as="geometry"/></mxCell><mxCell id="c13" value="Reads lag by a bound&lt;br&gt;(time or versions)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="172" width="150" height="40" as="geometry"/></mxCell><mxCell id="c14" value="★ Read your own writes&lt;br&gt;in a session (default)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="172" width="150" height="40" as="geometry"/></mxCell><mxCell id="c15" value="Ordered, never out of&lt;br&gt;order" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="172" width="150" height="40" as="geometry"/></mxCell><mxCell id="c16" value="No ordering guarantee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="172" width="150" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Latency / cost&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="213" width="110" height="40" as="geometry"/></mxCell><mxCell id="c18" value="Highest latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="213" width="150" height="40" as="geometry"/></mxCell><mxCell id="c19" value="High" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="213" width="150" height="40" as="geometry"/></mxCell><mxCell id="c20" value="Balanced" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="213" width="150" height="40" as="geometry"/></mxCell><mxCell id="c21" value="Low" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="213" width="150" height="40" as="geometry"/></mxCell><mxCell id="c22" value="★ Lowest latency and&lt;br&gt;cost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="213" width="150" height="40" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Note&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="253" width="110" height="40" as="geometry"/></mxCell><mxCell id="c24" value="✗ Not with multi-region&lt;br&gt;writes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="253" width="150" height="40" as="geometry"/></mxCell><mxCell id="c25" value="Use for ordered global&lt;br&gt;reads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="253" width="150" height="40" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="253" width="150" height="40" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="253" width="150" height="40" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="750" y="253" width="150" height="40" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="327" width="900" height="81" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="331" width="200" height="20" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Default, most apps&lt;/b&gt; → Session&lt;br&gt;&lt;b&gt;Strongest, linearizable&lt;/b&gt; → Strong&lt;br&gt;&lt;b&gt;Lowest latency, no ordering&lt;/b&gt; → Eventual" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="353" width="866" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8_6" name="8.6 PostgreSQL and MySQL Flexible Server"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1008" pageHeight="781" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c7" value="&lt;b&gt;8.6  PostgreSQL and MySQL Flexible Server&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="476" height="30" as="geometry"/></mxCell><mxCell id="c8" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="526" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c9" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="640" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c10" value="Flexible Server runs the community engines with zone-redundant HA, read replicas and stop/start. Use Private access (VNet injection) or Private Endpoint." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="908" height="21" as="geometry"/></mxCell><mxCell id="c11" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B4FB2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;App&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="196" y="161" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Primary (zone 1)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS / Aurora&lt;br&gt;PostgreSQL)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="532" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Standby (zone 2)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Multi-AZ standby)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="532" y="389" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Read replica&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Read replica)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="868" y="161" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="Zone-redundant HA keeps a synchronous standby in another zone, with automatic failover." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="520" height="21" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="641" width="908" height="81" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="645" width="200" height="20" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Open-source relational, PaaS&lt;/b&gt; → Flexible Server&lt;br&gt;&lt;b&gt;Scale reads&lt;/b&gt; → read replicas&lt;br&gt;&lt;b&gt;HA in zones&lt;/b&gt; → zone-redundant HA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="667" width="874" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8_7" name="8.7 Azure Managed Redis"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1081" pageHeight="491" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c6" value="&lt;b&gt;8.7  Azure Managed Redis&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="278" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="328" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c8" value="AZ-305 domain: Data storage (20-25%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="442" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c9" value="In-memory cache for session state, leaderboards and hot data; also a vector store. Cache-aside is the common pattern." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="982" height="21" as="geometry"/></mxCell><mxCell id="c10" value="1. read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="2. miss: load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;App&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="296" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Azure Managed Redis&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: ElastiCache /&lt;br&gt;MemoryDB)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Cache_Redis.svg;" vertex="1" parent="1"><mxGeometry x="632" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="968" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="Cache-aside: check cache, on miss read the DB and populate with a TTL. Supports geo-replication and&lt;br&gt;persistence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="640" height="35" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="367" width="982" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="371" width="200" height="20" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Reduce database load&lt;/b&gt; → cache-aside&lt;br&gt;&lt;b&gt;Session state&lt;/b&gt; → Redis" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="393" width="948" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>