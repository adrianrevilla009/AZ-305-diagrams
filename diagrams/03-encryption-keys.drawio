gn=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="241" width="150" height="40" as="geometry"/></mxCell><mxCell id="c23" value="FIPS 140-3 L3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="241" width="150" height="40" as="geometry"/></mxCell><mxCell id="c24" value="FIPS 140-2 L3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="241" width="150" height="40" as="geometry"/></mxCell><mxCell id="c25" value="PCI HSM v3, PCI PIN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="890" y="241" width="150" height="40" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Use it when&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="281" width="100" height="69" as="geometry"/></mxCell><mxCell id="c27" value="General secrets, keys&lt;br&gt;and certificates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="281" width="150" height="69" as="geometry"/></mxCell><mxCell id="c28" value="HSM-protected keys&lt;br&gt;without managing&lt;br&gt;hardware" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="290" y="281" width="150" height="69" as="geometry"/></mxCell><mxCell id="c29" value="Exclusive key control,&lt;br&gt;sovereignty, BYOK/HYOK.&lt;br&gt;Dedicated capacity with&lt;br&gt;no Key Vault throttling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="281" width="150" height="69" as="geometry"/></mxCell><mxCell id="c30" value="Migrating apps that&lt;br&gt;already use an on-prem&lt;br&gt;HSM (PKCS#11, JCE, CNG)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="281" width="150" height="69" as="geometry"/></mxCell><mxCell id="c31" value="⚠ Being retired in&lt;br&gt;favour of Cloud HSM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="281" width="150" height="69" as="geometry"/></mxCell><mxCell id="c32" value="PIN and payment&lt;br&gt;processing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="890" y="281" width="150" height="69" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="1000" height="113" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="388" width="200" height="20" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;HSM keys without managing hardware&lt;/b&gt; → Key Vault Premium&lt;br&gt;&lt;b&gt;Single-tenant and sovereignty&lt;/b&gt; → Managed HSM&lt;br&gt;&lt;b&gt;PKCS#11&lt;/b&gt; → Cloud HSM&lt;br&gt;&lt;b&gt;Card PINs / payments&lt;/b&gt; → Payment HSM&lt;br&gt;&lt;b&gt;Customer can revoke keys&lt;/b&gt; → CMK" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="966" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d3_3" name="3.3 Encryption map: at rest, in transit, in use"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="586" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;3.3  Encryption map: at rest, in transit, in use&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="557" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Concept / cheat sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="607" y="19" width="160" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="779" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Default encryption needs nothing from you. Add customer-managed keys when you need control or revocation, Always Encrypted when even the DBA must not see data, confidential computing for data in&lt;br&gt;use." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1150" height="36" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Azure feature&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="420" height="34" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;AWS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="250" height="34" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Notes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="330" height="34" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;At rest (default)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="150" height="28" as="geometry"/></mxCell><mxCell id="c10" value="Storage, SQL and Cosmos DB encrypt with Microsoft-managed keys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="134" width="420" height="28" as="geometry"/></mxCell><mxCell id="c11" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="134" width="250" height="28" as="geometry"/></mxCell><mxCell id="c12" value="Nothing to configure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="134" width="330" height="28" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;At rest with your&lt;br&gt;keys (CMK)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="150" height="40" as="geometry"/></mxCell><mxCell id="c14" value="Key lives in your Key Vault or Managed HSM; you rotate and can&lt;br&gt;revoke it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="162" width="420" height="40" as="geometry"/></mxCell><mxCell id="c15" value="SSE-KMS with CMK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="162" width="250" height="40" as="geometry"/></mxCell><mxCell id="c16" value="Purge protection is mandatory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="162" width="330" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;VM disks&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="203" width="150" height="40" as="geometry"/></mxCell><mxCell id="c18" value="SSE + CMK via Disk Encryption Set. Encryption at host also covers&lt;br&gt;cache and temp disk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="203" width="420" height="40" as="geometry"/></mxCell><mxCell id="c19" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="203" width="250" height="40" as="geometry"/></mxCell><mxCell id="c20" value="Azure Disk Encryption (BitLocker / DM-Crypt) is the&lt;br&gt;older option" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="203" width="330" height="40" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;SQL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="243" width="150" height="40" as="geometry"/></mxCell><mxCell id="c22" value="TDE (default). Always Encrypted: client-side, server never sees&lt;br&gt;clear data. Dynamic Data Masking" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="243" width="420" height="40" as="geometry"/></mxCell><mxCell id="c23" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="243" width="250" height="40" as="geometry"/></mxCell><mxCell id="c24" value="Always Encrypted: not even the DBA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="243" width="330" height="40" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;In transit&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="283" width="150" height="28" as="geometry"/></mxCell><mxCell id="c26" value="TLS 1.2+, IPsec on VPN, MACsec on ExpressRoute Direct" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="283" width="420" height="28" as="geometry"/></mxCell><mxCell id="c27" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="283" width="250" height="28" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="283" width="330" height="28" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Double encryption&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="311" width="150" height="28" as="geometry"/></mxCell><mxCell id="c30" value="Infrastructure encryption in Storage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="311" width="420" height="28" as="geometry"/></mxCell><mxCell id="c31" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="311" width="250" height="28" as="geometry"/></mxCell><mxCell id="c32" value="For regulatory requirements" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="311" width="330" height="28" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;In use&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="339" width="150" height="40" as="geometry"/></mxCell><mxCell id="c34" value="Confidential computing: confidential VMs and containers (AMD&lt;br&gt;SEV-SNP, Intel TDX)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="339" width="420" height="40" as="geometry"/></mxCell><mxCell id="c35" value="Nitro Enclaves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610" y="339" width="250" height="40" as="geometry"/></mxCell><mxCell id="c36" value="Data encrypted while being processed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="339" width="330" height="40" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="1150" height="113" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="418" width="200" height="20" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Customer revokes the keys&lt;/b&gt; → CMK&lt;br&gt;&lt;b&gt;Not even the DBA sees the data&lt;/b&gt; → Always Encrypted&lt;br&gt;&lt;b&gt;Encrypted while being processed&lt;/b&gt; → confidential computing&lt;br&gt;&lt;b&gt;Prevent permanent deletion&lt;/b&gt; → purge protection&lt;br&gt;&lt;b&gt;Regulatory double encryption&lt;/b&gt; → infrastructure encryption (Storage)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="1116" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>