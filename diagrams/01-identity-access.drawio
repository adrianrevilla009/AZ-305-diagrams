alAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="723" width="800" height="35" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="793" width="1385" height="81" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="797" width="200" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Least privilege for secrets&lt;/b&gt; → Key Vault Secrets User&lt;br&gt;&lt;b&gt;Conditions on blob tags or attributes&lt;/b&gt; → ABAC&lt;br&gt;&lt;b&gt;Manage access only&lt;/b&gt; → User Access Administrator" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="819" width="1351" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>