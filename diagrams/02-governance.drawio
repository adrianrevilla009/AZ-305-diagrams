value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Tenant root group&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Organizations root)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="856" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Organisation&lt;br&gt;management group&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Organizations OU)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="856" y="252" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Platform&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: OU)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="394" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Landing zones&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: OU)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="898" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Sandbox&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: OU)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="1276" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Decommissioned&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: OU)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="1549" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="226" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Management&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="436" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Connectivity&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="646" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Corp workloads&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="898" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Online workloads&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="1129" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Experiments&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="1339" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c14" value="Limits: up to 6 levels deep, 10,000 management groups per tenant. Each MG or subscription has a single parent. Microsoft recommends flat hierarchies of&lt;br&gt;3-4 levels. New subscriptions land in the tenant root group." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="754" width="900" height="35" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="823" width="1656" height="81" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="827" width="200" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Isolate billing and quotas&lt;/b&gt; → separate subscriptions&lt;br&gt;&lt;b&gt;Apply something to many subscriptions&lt;/b&gt; → management group&lt;br&gt;&lt;b&gt;Prohibit regions&lt;/b&gt; → Policy Deny (Allowed locations)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="849" width="1622" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2_2" name="2.2 Azure Policy: effects and evaluation order"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1299" pageHeight="936" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c10" value="&lt;b&gt;2.2  Azure Policy: effects and evaluation order&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="545" height="30" as="geometry"/></mxCell><mxCell id="c11" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="595" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c12" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="709" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c13" value="Policy controls what can exist and how it must be configured. RBAC controls who can do what. Start in Audit (or DoNotEnforce) before moving to Deny." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1199" height="21" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Effect&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="145" y="100" width="170" height="34" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;What it does&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="100" width="440" height="34" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;AWS analogy&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="755" y="100" width="220" height="34" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Deny&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="145" y="134" width="170" height="28" as="geometry"/></mxCell><mxCell id="c18" value="★ Blocks creating or changing something non-compliant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="134" width="440" height="28" as="geometry"/></mxCell><mxCell id="c19" value="SCP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="134" width="220" height="28" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Audit / AuditIfNotExists&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="145" y="162" width="170" height="28" as="geometry"/></mxCell><mxCell id="c21" value="Marks non-compliant but does not block" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="162" width="440" height="28" as="geometry"/></mxCell><mxCell id="c22" value="Config rule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="162" width="220" height="28" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Append / Modify&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="145" y="190" width="170" height="40" as="geometry"/></mxCell><mxCell id="c24" value="Adds or changes properties or tags. Modify also acts on existing&lt;br&gt;resources" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="190" width="440" height="40" as="geometry"/></mxCell><mxCell id="c25" value="Tag policies (partly)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="190" width="220" height="40" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;DeployIfNotExists&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="145" y="231" width="170" height="28" as="geometry"/></mxCell><mxCell id="c27" value="Deploys a related resource if missing (diagnostic settings, an agent)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="231" width="440" height="28" as="geometry"/></mxCell><mxCell id="c28" value="Config remediation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="231" width="220" height="28" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;DenyAction&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="145" y="259" width="170" height="28" as="geometry"/></mxCell><mxCell id="c30" value="Blocks specific actions such as DELETE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="259" width="440" height="28" as="geometry"/></mxCell><mxCell id="c31" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="259" width="220" height="28" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Disabled / Manual&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="145" y="287" width="170" height="40" as="geometry"/></mxCell><mxCell id="c33" value="Disabled turns the policy off. Manual attests controls Azure cannot&lt;br&gt;evaluate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="315" y="287" width="440" height="40" as="geometry"/></mxCell><mxCell id="c34" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="287" width="220" height="40" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="&lt;b&gt;1 Disabled&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="195" y="590" width="110" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2 Append / Modify&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="348" y="590" width="140" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3 Deny&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEDED;strokeColor=#C00000;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="552" y="590" width="110" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4 Audit&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="590" width="110" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5 AuditIfNotExists&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="889" y="590" width="150" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6 DenyAction&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEDED;strokeColor=#C00000;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1109" y="590" width="130" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Evaluation order:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="45" y="600" width="150" height="21" as="geometry"/></mxCell><mxCell id="c9" value="Initiative = a set of policies (AWS: conformance pack), e.g. Microsoft cloud security benchmark, ISO 27001, PCI DSS. DeployIfNotExists and Modify need&lt;br&gt;a managed identity on the assignment; existing resources are fixed with a remediation task." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="727" width="900" height="35" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="796" width="1199" height="81" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="800" width="200" height="20" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Prohibit regions&lt;/b&gt; → Deny (Allowed locations)&lt;br&gt;&lt;b&gt;Force diagnostic settings&lt;/b&gt; → DeployIfNotExists&lt;br&gt;&lt;b&gt;Enforce or correct configuration at deploy time&lt;/b&gt; → Azure Policy, not Defender" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="822" width="1165" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2_3" name="2.3 Entra ID Governance"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1009" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c12" value="&lt;b&gt;2.3  Entra ID Governance&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="278" height="30" as="geometry"/></mxCell><mxCell id="c13" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="328" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c14" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="442" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c15" value="Governance of identity lifecycle and access. AWS has no native IGA product; the closest is IAM Identity Center + Access Analyzer. Licensing: PIM, access&lt;br&gt;reviews and basic entitlement management came with P2; advanced features need Entra ID Governance ⚠ verify the current split." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="36" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Privileged Identity&lt;br&gt;Management (PIM)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Entra_Privileged_Identity_Management.svg;" vertex="1" parent="1"><mxGeometry x="88" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value="Roles are eligible, activated with approval and MFA, and expire. Just-in-time&lt;br&gt;privileged access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="219" y="100" width="520" height="48" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Entitlement management&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Identity_Governance.svg;" vertex="1" parent="1"><mxGeometry x="88" y="267" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="Access packages with request, approval and expiry. Invites and removes B2B guests&lt;br&gt;automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="219" y="267" width="520" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Access reviews&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Groups.svg;" vertex="1" parent="1"><mxGeometry x="88" y="434" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="Periodic recertification of groups, apps, roles and guests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="219" y="434" width="520" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Lifecycle Workflows&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="88" y="602" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value="Automated joiner, mover and leaver processes (up to 50 workflows)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="219" y="602" width="520" height="48" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Terms of use&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/security/Conditional_Access.svg;" vertex="1" parent="1"><mxGeometry x="88" y="769" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value="Legal acceptance before access, enforced through Conditional Access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="219" y="769" width="520" height="48" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="869" width="900" height="81" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="873" width="200" height="20" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Review guests every 90 days&lt;/b&gt; → access reviews&lt;br&gt;&lt;b&gt;Just-in-time admin roles&lt;/b&gt; → PIM&lt;br&gt;&lt;b&gt;Request, approve and expire access packages&lt;/b&gt; → entitlement management" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="895" width="866" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2_4" name="2.4 Multi-tenant and hybrid management: Lighthouse and Arc"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="809" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="&lt;b&gt;2.4  Multi-tenant and hybrid management: Lighthouse and Arc&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="684" height="30" as="geometry"/></mxCell><mxCell id="c10" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="734" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c11" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="848" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c12" value="Lighthouse gives a service provider delegated access to customer tenants without guest accounts. Arc projects servers, Kubernetes and SQL from on-prem&lt;br&gt;or other clouds into Azure so Policy, RBAC, Defender and Monitor apply to them." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="36" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="project" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="manage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Service provider&lt;br&gt;tenant&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Delegated admin)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1"><mxGeometry x="84" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Azure Lighthouse&lt;br&gt;(delegation, no guest&lt;br&gt;accounts)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Cross-account roles&lt;br&gt;/ delegated admin)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Azure_Lighthouse.svg;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Customer tenant A&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="798" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Customer tenant B&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Account)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="798" y="313" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;On-prem / other-cloud&lt;br&gt;servers, Kubernetes,&lt;br&gt;SQL&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="84" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Azure Arc&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Systems Manager&lt;br&gt;hybrid + EKS Anywhere)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Azure_Arc.svg;" vertex="1" parent="1"><mxGeometry x="420" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Azure control plane:&lt;br&gt;Policy, RBAC,&lt;br&gt;Defender, Monitor&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="798" y="556" width="48" height="48" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="900" height="64" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="689" width="200" height="20" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Delegated multi-tenant management for an MSP&lt;/b&gt; → Azure Lighthouse&lt;br&gt;&lt;b&gt;Apply Policy / Defender to servers outside Azure&lt;/b&gt; → Azure Arc" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="711" width="866" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2_5" name="2.5 Boundaries: what isolates what"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1110" pageHeight="558" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;2.5  Boundaries: what isolates what&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="406" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Concept / cheat sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B6B6B;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="456" y="19" width="160" height="22" as="geometry"/></mxCell><mxCell id="c4" value="AZ-305 domain: Identity, governance and monitoring (25-30%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="628" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Each level of the hierarchy exists for a reason. Use this table to choose the right boundary." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1010" height="21" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Azure&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="330" height="34" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;AWS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="170" height="34" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Notes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="360" height="34" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Tenant&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="150" height="28" as="geometry"/></mxCell><mxCell id="c10" value="Identity boundary. A subscription trusts one tenant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="134" width="330" height="28" as="geometry"/></mxCell><mxCell id="c11" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="134" width="170" height="28" as="geometry"/></mxCell><mxCell id="c12" value="Entra ID directory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="134" width="360" height="28" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Management group&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="150" height="28" as="geometry"/></mxCell><mxCell id="c14" value="Groups subscriptions to apply Policy and RBAC in bulk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="162" width="330" height="28" as="geometry"/></mxCell><mxCell id="c15" value="OU (Organizations)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="162" width="170" height="28" as="geometry"/></mxCell><mxCell id="c16" value="6 levels, 10,000 per tenant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="162" width="360" height="28" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Subscription&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="28" as="geometry"/></mxCell><mxCell id="c18" value="Billing, quota and access boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="190" width="330" height="28" as="geometry"/></mxCell><mxCell id="c19" value="Account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="170" height="28" as="geometry"/></mxCell><mxCell id="c20" value="New ones land in the tenant root group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="190" width="360" height="28" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Resource group&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="150" height="40" as="geometry"/></mxCell><mxCell id="c22" value="Logical container for resources with the same&lt;br&gt;lifecycle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="218" width="330" height="40" as="geometry"/></mxCell><mxCell id="c23" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="218" width="170" height="40" as="geometry"/></mxCell><mxCell id="c24" value="A resource belongs to exactly one RG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="218" width="360" height="40" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Tags&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="259" width="150" height="40" as="geometry"/></mxCell><mxCell id="c26" value="Metadata for cost and ownership" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="259" width="330" height="40" as="geometry"/></mxCell><mxCell id="c27" value="Cost allocation tags" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="259" width="170" height="40" as="geometry"/></mxCell><mxCell id="c28" value="⚠ Not inherited by default: use a Modify / &amp;#x27;Inherit a tag&amp;#x27;&lt;br&gt;policy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="259" width="360" height="40" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Resource locks&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="299" width="150" height="28" as="geometry"/></mxCell><mxCell id="c30" value="CanNotDelete or ReadOnly, inherited downward" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="299" width="330" height="28" as="geometry"/></mxCell><mxCell id="c31" value="Deletion protection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="299" width="170" height="28" as="geometry"/></mxCell><mxCell id="c32" value="Only Owner and User Access Administrator can remove them" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="299" width="360" height="28" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Blueprints&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="327" width="150" height="40" as="geometry"/></mxCell><mxCell id="c34" value="Retired service (announced for September 2026) ⚠&lt;br&gt;verify" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="190" y="327" width="330" height="40" as="geometry"/></mxCell><mxCell id="c35" value="Service Catalog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="327" width="170" height="40" as="geometry"/></mxCell><mxCell id="c36" value="Replaced by Template Specs + Deployment Stacks + Policy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="327" width="360" height="40" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="401" width="1010" height="97" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="405" width="200" height="20" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Isolate billing and quotas&lt;/b&gt; → separate subscriptions&lt;br&gt;&lt;b&gt;Apply something to many subscriptions&lt;/b&gt; → management group&lt;br&gt;&lt;b&gt;Tags are not inherited by default&lt;/b&gt; → Policy Modify / inherit a tag&lt;br&gt;&lt;b&gt;Prevent accidental deletion&lt;/b&gt; → resource lock (CanNotDelete / ReadOnly)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="427" width="976" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>