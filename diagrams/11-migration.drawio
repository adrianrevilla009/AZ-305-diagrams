><mxCell id="c4" value="&lt;b&gt;Ready (landing zone)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="519" y="100" width="170" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Adopt (migrate or&lt;br&gt;innovate)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#6FA800;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="718" y="100" width="170" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Govern&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C55A11;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="918" y="100" width="170" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Manage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C55A11;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1118" y="100" width="170" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Assess&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="222" width="140" height="40" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Migrate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="492" y="222" width="140" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Optimize&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="744" y="222" width="140" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Secure and manage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="981" y="222" width="170" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Migration journey:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="150" height="21" as="geometry"/></mxCell><mxCell id="c13" value="Before moving workloads, build the landing zone: subscriptions, management groups, network, identity and policies&lt;br&gt;(AWS: Control Tower)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="45" y="586" width="700" height="35" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="1248" height="97" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="660" width="200" height="20" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Move fast without touching code&lt;/b&gt; → Rehost&lt;br&gt;&lt;b&gt;PaaS with minimal changes&lt;/b&gt; → Refactor&lt;br&gt;&lt;b&gt;Several hundred VMs, low downtime&lt;/b&gt; → Azure Migrate Server Migration&lt;br&gt;&lt;b&gt;Keep vSphere as it is&lt;/b&gt; → Azure VMware Solution" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="682" width="1214" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d11_2" name="11.2 Azure Migrate: server migration"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1388" pageHeight="928" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c14" value="&lt;b&gt;11.2  Azure Migrate: server migration&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="429" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="479" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c16" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="593" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c17" value="Azure Migrate discovers servers (VMware, Hyper-V, physical, other clouds), sizes them from real performance and replicates them continuously for a short cutover. AVS keeps vSphere unchanged; Resource Mover relocates&lt;br&gt;between Azure regions." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1288" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#8A8A8A;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="189" y="100" width="162" height="514" as="geometry"/></mxCell><mxCell id="c18" value="right-size from real performance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="replicate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7F7F7F;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="&lt;b&gt;VMware&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="40" width="110" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Hyper-V&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="177" width="110" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Physical&lt;br&gt;servers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="314" width="110" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Other clouds&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontSize=11;arcSize=12;" vertex="1" parent="c2"><mxGeometry x="26" y="450" width="110" height="40" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Azure Migrate:&lt;br&gt;discovery + assessment&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Migration Hub +&lt;br&gt;Application Discovery)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/migrate/Azure_Migrate.svg;" vertex="1" parent="1"><mxGeometry x="582" y="292" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Server Migration:&lt;br&gt;continuous replication&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Application&lt;br&gt;Migration Service (MGN))&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/migrate/Azure_Migrate.svg;" vertex="1" parent="1"><mxGeometry x="897" y="292" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Azure VMs&lt;br&gt;(low-downtime cutover)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/Virtual_Machine.svg;" vertex="1" parent="1"><mxGeometry x="1233" y="292" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Azure VMware Solution&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: VMware Cloud on AWS)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/azure_vmware_solution/AVS.svg;" vertex="1" parent="1"><mxGeometry x="897" y="535" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Resource Mover (region&lt;br&gt;to region)&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/other/Resource_Mover.svg;" vertex="1" parent="1"><mxGeometry x="1233" y="535" width="48" height="48" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;App Service Migration&lt;br&gt;Assistant&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/compute/App_Services.svg;" vertex="1" parent="1"><mxGeometry x="582" y="535" width="48" height="48" as="geometry"/></mxCell><mxCell id="c13" value="Assessment is a point-in-time snapshot (recalculate). Dependency analysis groups servers into apps, agentless or with an agent.&lt;br&gt;Business case compares on-prem cost with Azure. The containerization tool is for containers and Java (AWS App2Container)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="760" height="35" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="1288" height="97" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="776" width="200" height="20" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Hundreds of VMware VMs, low downtime&lt;/b&gt; → Azure Migrate Server Migration&lt;br&gt;&lt;b&gt;Keep vSphere unchanged&lt;/b&gt; → Azure VMware Solution&lt;br&gt;&lt;b&gt;Move resources between regions&lt;/b&gt; → Resource Mover&lt;br&gt;&lt;b&gt;.NET / PHP websites to PaaS&lt;/b&gt; → App Service Migration Assistant" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="798" width="1254" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d11_3" name="11.3 Database migration paths"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1232" pageHeight="855" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c12" value="&lt;b&gt;11.3  Database migration paths&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="348" height="30" as="geometry"/></mxCell><mxCell id="c13" value="Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="398" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c14" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="512" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c15" value="Assess compatibility first (DMA), then migrate with DMS online (continuous replication, short cutover) or offline (full stop). Heterogeneous moves need a schema conversion step." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1132" height="21" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="then DMS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value='&lt;b&gt;Source: SQL Server&lt;br&gt;on-prem&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS source)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="88" y="252" width="48" height="48" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;Data Migration&lt;br&gt;Assistant (assessment)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Schema Conversion&lt;br&gt;Tool)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_Migration_Services.svg;" vertex="1" parent="1"><mxGeometry x="402" y="252" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Database Migration&lt;br&gt;Service: online or&lt;br&gt;offline&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: AWS DMS)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_Migration_Services.svg;" vertex="1" parent="1"><mxGeometry x="718" y="252" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;SQL Database&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS for SQL Server)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Database.svg;" vertex="1" parent="1"><mxGeometry x="1074" y="100" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;SQL Managed Instance&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS Custom for SQL&lt;br&gt;Server)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/SQL_Managed_Instance.svg;" vertex="1" parent="1"><mxGeometry x="1074" y="252" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;SQL Server on VM&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SQL Server on EC2)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_SQL_VM.svg;" vertex="1" parent="1"><mxGeometry x="1074" y="404" width="48" height="48" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Oracle / heterogeneous&lt;br&gt;source&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS for Oracle)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Oracle_Database.svg;" vertex="1" parent="1"><mxGeometry x="88" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;SSMA / ora2pg (schema&lt;br&gt;conversion)&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: SCT)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_Migration_Services.svg;" vertex="1" parent="1"><mxGeometry x="402" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;PostgreSQL / MySQL&lt;br&gt;Flexible Server&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: RDS / Aurora)&lt;/font&gt;' style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1"><mxGeometry x="1074" y="586" width="48" height="48" as="geometry"/></mxCell><mxCell id="c11" value="SQL Server to SQL MI with low downtime: DMS online, Log Replay&lt;br&gt;Service (LRS), native restore, or MI link (distributed Always&lt;br&gt;On)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="492" y="494" width="380" height="50" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1132" height="81" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="719" width="200" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;SQL Server with SQL Agent / linked servers to PaaS&lt;/b&gt; → SQL MI with DMS online or Log Replay Service&lt;br&gt;&lt;b&gt;Low-downtime SQL Server to MI&lt;/b&gt; → DMS online, LRS, native restore or MI link&lt;br&gt;&lt;b&gt;Oracle to PostgreSQL&lt;/b&gt; → SSMA or ora2pg for the schema (AWS SCT)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="741" width="1098" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d11_4" name="11.4 Data transfer: online or offline?"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1235" pageHeight="876" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;11.4  Data transfer: online or offline?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="452" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Decision map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="502" y="19" width="102" height="22" as="geometry"/></mxCell><mxCell id="c5" value="AZ-305 domain: Infrastructure (30-35%)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="616" y="19" width="420" height="22" as="geometry"/></mxCell><mxCell id="c6" value="Decide with arithmetic: size divided by bandwidth. 200 TB over 1 Gbps takes about 26 days. If that does not fit the window, go offline with Data Box." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1135" height="21" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;AzCopy&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: s3 sync)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Storage_Explorer.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="195" y="100" width="140" height="101" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Storage Mover&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: DataSync)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/other/Azure_Storage_Mover.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="335" y="100" width="140" height="101" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Data Box Disk&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Snowcone)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Data_Box.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="475" y="100" width="140" height="101" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Data Box&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Snowball Edge)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Data_Box.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="615" y="100" width="140" height="101" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Data Box Heavy&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Snowmobile /&lt;br&gt;several Snowballs)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Data_Box.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="755" y="100" width="140" height="101" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Data Box Gateway&lt;/b&gt;&lt;br&gt;&lt;font color="#C55A11"&gt;(AWS: Storage Gateway)&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Data_Box_Edge.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="895" y="100" width="140" height="101" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Import / Export&lt;/b&gt;" style="shape=label;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#0078D4;fontSize=11;image=img/lib/azure2/storage/Import_Export_Jobs.svg;imageWidth=40;imageHeight=40;imageAlign=center;imageVerticalAlign=top;verticalAlign=bottom;spacingBottom=4;imageBorder=none;" vertex="1" parent="1"><mxGeometry x="1035" y="100" width="140" height="101" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Mode&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="75" y="201" width="120" height="55" as="geometry"/></mxCell><mxCell id="c15" value="Online (CLI over the&lt;br&gt;network)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="201" width="140" height="55" as="geometry"/></mxCell><mxCell id="c16" value="Online (orchestrated&lt;br&gt;NFS/SMB shares to&lt;br&gt;Blob/Files)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="335" y="201" width="140" height="55" as="geometry"/></mxCell><mxCell id="c17" value="★ Offline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="201" width="140" height="55" as="geometry"/></mxCell><mxCell id="c18" value="★ Offline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="615" y="201" width="140" height="55" as="geometry"/></mxCell><mxCell id="c19" value="★ Offline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBFA;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="201" width="140" height="55" as="geometry"/></mxCell><mxCell id="c20" value="Online (virtual&lt;br&gt;appliance uploads&lt;br&gt;over the network)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="201" width="140" height="55" as="geometry"/></mxCell><mxCell id="c21" value="Offline: you ship&lt;br&gt;your own disks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1035" y="201" width="140" height="55" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Capacity /&lt;br&gt;interface&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="75" y="255" width="120" height="55" as="geometry"/></mxCell><mxCell id="c23" value="Copy to Blob or Files" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="255" width="140" height="55" as="geometry"/></mxCell><mxCell id="c24" value="Shares to Blob /&lt;br&gt;Files" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="335" y="255" width="140" height="55" as="geometry"/></mxCell><mxCell id="c25" value="About 35 TB usable&lt;br&gt;(up to 5 x 8 TB), USB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="255" width="140" height="55" as="geometry"/></mxCell><mxCell id="c26" value="About 80 TB usable&lt;br&gt;(100 TB raw),&lt;br&gt;SMB/NFS, AES-256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="615" y="255" width="140" height="55" as="geometry"/></mxCell><mxCell id="c27" value="About 800 TB usable&lt;br&gt;(1 PB raw)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="255" width="140" height="55" as="geometry"/></mxCell><mxCell id="c28" value="Virtual appliance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="255" width="140" height="55" as="geometry"/></mxCell><mxCell id="c29" value="Use if no Data Box is&lt;br&gt;available in your&lt;br&gt;region" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1035" y="255" width="140" height="55" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Export from&lt;br&gt;Azure?&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="75" y="310" width="120" height="40" as="geometry"/></mxCell><mxCell id="c31" value="n/a" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="310" width="140" height="40" as="geometry"/></mxCell><mxCell id="c32" value="n/a" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="335" y="310" width="140" height="40" as="geometry"/></mxCell><mxCell id="c33" value="✗ No" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="310" width="140" height="40" as="geometry"/></mxCell><mxCell id="c34" value="✓ Yes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E0;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="615" y="310" width="140" height="40" as="geometry"/></mxCell><mxCell id="c35" value="✗ No" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755" y="310" width="140" height="40" as="geometry"/></mxCell><mxCell id="c36" value="n/a" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="310" width="140" height="40" as="geometry"/></mxCell><mxCell id="c37" value="✓ Yes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E0;strokeColor=#BFBFBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1035" y="310" width="140" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Rule of thumb: time = size / bandwidth. 200 TB over 1 Gbps is about 26 days. If it does not fit the&lt;br&gt;migration window, go offline." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="640" height="35" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="1135" height="81" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;EXAM RULES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="50" y="739" width="200" height="20" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;A few TB, good bandwidth&lt;/b&gt; → AzCopy or Storage Mover&lt;br&gt;&lt;b&gt;400 TB and a slow network&lt;/b&gt; → several Data Box or Data Box Heavy&lt;br&gt;&lt;b&gt;Export from Azure to disk&lt;/b&gt; → Data Box (Disk and Heavy do not support export)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="761" width="1101" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>